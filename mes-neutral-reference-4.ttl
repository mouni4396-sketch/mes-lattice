@prefix ref:  <https://ontology.yourorg.com/mes-ref#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dct:  <http://purl.org/dc/terms/> .

<https://ontology.yourorg.com/mes-ref> a owl:Ontology ;
    dct:title "MES Neutral Reference Layer" ;
    dct:description "Vendor-neutral semiconductor MES reference ontology (ISA-95 / SEMI GEM300). Two-axis: Data Objects (nouns) x Capabilities (verbs), linked by ref:operatesOn. Definitional schema only (no live data; run: layer is separate)." ;
    dct:creator "MES Neutral Reference Layer project" ;
    dct:created "2026-01-01"^^xsd:date ;
    dct:modified "2026-07-07"^^xsd:date ;
    owl:versionInfo "MASTER-11 (material + quality/defect/reason committed)" ;
    dct:license "Internal — project working draft" .

# ===== ANNOTATION PROPERTIES =====
ref:grounding a owl:AnnotationProperty ; rdfs:comment "standard family: ISA / SEMI / ISA + SEMI / Derived / —" .
ref:status a owl:AnnotationProperty ; rdfs:comment "Grounded / Structure / Derived" .
ref:mesDomain a owl:AnnotationProperty ; rdfs:comment "cluster domain (Material, Quality, ...)" .
ref:isa95Area a owl:AnnotationProperty ; rdfs:comment "ISA-95 area" .
ref:standardAnchor a owl:AnnotationProperty ; rdfs:comment "ISA-95 / SEMI anchor" .
ref:manufacturingStage a owl:AnnotationProperty ; rdfs:comment "FE / BE / AP / FullFlow / CrossStage" .
ref:cardinality a owl:AnnotationProperty ; rdfs:comment "queryable cardinality annotation (enforcement is run:/SHACL)" .
ref:valueKind a owl:AnnotationProperty ; rdfs:comment "plain / enum / lookup" .
ref:operatesOnRaw a owl:AnnotationProperty ; rdfs:comment "raw operates-on list (source text)" .
ref:seamNote a owl:AnnotationProperty ; rdfs:comment "adjacent-system seam note" .
ref:operatesOn a owl:ObjectProperty ; rdfs:domain ref:Capability ; rdfs:range ref:DataObject ; rdfs:label "operatesOn" .

# ===== AXIS ROOTS =====
ref:DataObject a owl:Class ; rdfs:label "Data Object" ; rdfs:comment "Root of the noun axis." .
ref:Capability a owl:Class ; rdfs:label "Capability" ; rdfs:comment "Root of the verb axis (MES competency areas)." .

# ===== DATA OBJECTS =====
ref:Product a owl:Class ;
    rdfs:label "Product" ;
    rdfs:subClassOf ref:DataObject ;
    skos:definition "Specific sourced device type (the device/SKU spec)." ;
    ref:standardTerm "MaterialDefinition" ;
    ref:mesDomain "Material" ;
    ref:isa95Area "Material Definition" ;
    ref:grounding "ISA" ;
    ref:status "Grounded" .

ref:Lot a owl:Class ;
    rdfs:label "Lot" ;
    rdfs:subClassOf ref:DataObject ;
    skos:definition "Identified quantity of material — trackable batch of wafers." ;
    ref:standardTerm "MaterialLot" ;
    ref:mesDomain "Material" ;
    ref:isa95Area "Material Lot" ;
    ref:standardAnchor "E90 (context)" ;
    ref:grounding "ISA + SEMI" ;
    ref:status "Grounded" .

ref:Substrate a owl:Class ;
    rdfs:label "Substrate / Wafer" ;
    rdfs:subClassOf ref:ProductMaterial ;
    skos:definition "Individually identified wafer / panel / strip." ;
    ref:standardTerm "MaterialSublot" ;
    ref:mesDomain "Material" ;
    ref:isa95Area "Material Sublot" ;
    ref:standardAnchor "E90 Substrate" ;
    ref:grounding "ISA + SEMI" ;
    ref:manufacturingStage "FE" ;
    ref:status "Grounded" .

ref:TestSpec a owl:Class ;
    rdfs:label "Test Spec" ;
    rdfs:subClassOf ref:DataObject ;
    skos:definition "Test / QA spec attachable to product / lot / substrate." ;
    ref:standardTerm "MaterialTestSpecification" ;
    ref:mesDomain "Material" ;
    ref:isa95Area "Material model" ;
    ref:grounding "ISA" ;
    ref:status "Grounded" .

ref:Carrier a owl:Class ;
    rdfs:label "Carrier" ;
    rdfs:subClassOf ref:DataObject ;
    skos:definition "FOUP / Cassette / Pod holding substrates." ;
    ref:standardTerm "Carrier" ;
    ref:mesDomain "Material" ;
    ref:standardAnchor "E87" ;
    ref:grounding "SEMI" ;
    ref:status "Grounded" .

ref:WaferMap a owl:Class ;
    rdfs:label "Wafer Map" ;
    rdfs:subClassOf ref:DataObject ;
    skos:definition "Location-indexed die / bin map." ;
    ref:standardTerm "SubstrateMap" ;
    ref:mesDomain "Material" ;
    ref:standardAnchor "E142" ;
    ref:grounding "SEMI" ;
    ref:manufacturingStage "CrossStage" ;
    ref:status "Grounded" .

ref:Route a owl:Class ;
    rdfs:label "Route" ;
    rdfs:subClassOf ref:DataObject ;
    skos:definition "Ordered sequence of steps to build a product (+ BOM, product link)." ;
    ref:standardTerm "ProductDefinition" ;
    ref:mesDomain "Routing" ;
    ref:isa95Area "Product Definition" ;
    ref:grounding "ISA" ;
    ref:status "Structure" .

ref:RouteOperation a owl:Class ;
    rdfs:label "Route Operation" ;
    rdfs:subClassOf ref:DataObject ;
    skos:definition "A step's placement within one route (position + local context)." ;
    ref:standardTerm "ProductSegment" ;
    ref:mesDomain "Routing" ;
    ref:isa95Area "Product Segment" ;
    ref:grounding "ISA" ;
    ref:status "Structure" .

ref:Step a owl:Class ;
    rdfs:label "Operation / Step" ;
    rdfs:subClassOf ref:DataObject ;
    skos:definition "Generic, reusable manufacturing action node." ;
    ref:standardTerm "ProcessSegment" ;
    ref:mesDomain "Routing" ;
    ref:isa95Area "Process Segment" ;
    ref:grounding "ISA" ;
    ref:status "Structure" .

ref:BOM a owl:Class ;
    rdfs:label "BOM" ;
    rdfs:subClassOf ref:DataObject ;
    skos:definition "Materials consumed / produced by the route." ;
    ref:standardTerm "BillOfMaterial" ;
    ref:mesDomain "Routing" ;
    ref:isa95Area "Product Definition" ;
    ref:grounding "ISA" ;
    ref:status "Structure" .

ref:TimeConstraint a owl:Class ;
    rdfs:label "Q-Time Constraint" ;
    rdfs:subClassOf ref:DataObject ;
    skos:definition "Max (and optional min) time allowed between two route operations — e.g. Q-time before oxidation to prevent native-oxide growth." ;
    ref:standardTerm "(segment constraint)" ;
    ref:mesDomain "Routing" ;
    ref:isa95Area "Process Segment constraint" ;
    ref:grounding "ISA" ;
    ref:status "Structure" .

ref:ReworkPath a owl:Class ;
    rdfs:label "Rework Path" ;
    rdfs:subClassOf ref:DataObject ;
    skos:definition "Non-standard path a lot takes when inspection fails, then rejoins the main route." ;
    ref:standardTerm "(alternate sequencing)" ;
    ref:mesDomain "Routing" ;
    ref:isa95Area "Product Definition (alternate)" ;
    ref:grounding "ISA" ;
    ref:status "Structure" .

ref:Recipe a owl:Class ;
    rdfs:label "Recipe" ;
    rdfs:subClassOf ref:DataObject ;
    skos:definition "Engineering program / parameters executed by the tool." ;
    ref:standardTerm "Recipe" ;
    ref:mesDomain "Recipe" ;
    ref:standardAnchor "E40/E42/E139" ;
    ref:grounding "SEMI" ;
    ref:status "Structure" .

ref:EquipmentGroup a owl:Class ;
    rdfs:label "Equipment Group" ;
    rdfs:subClassOf ref:DataObject ;
    skos:definition "Classification grouping of equipment." ;
    ref:standardTerm "EquipmentClass" ;
    ref:mesDomain "Resource" ;
    ref:isa95Area "Equipment model" ;
    ref:grounding "ISA" ;
    ref:status "Grounded" .

ref:Equipment a owl:Class ;
    rdfs:label "Equipment" ;
    rdfs:subClassOf ref:DataObject ;
    skos:definition "Logical production tool — the role / position in the line." ;
    ref:standardTerm "Equipment" ;
    ref:mesDomain "Resource" ;
    ref:isa95Area "Equipment" ;
    ref:standardAnchor "E30" ;
    ref:grounding "ISA + SEMI" ;
    ref:status "Grounded" .

ref:PhysicalEquipment a owl:Class ;
    rdfs:label "Physical Equipment" ;
    rdfs:subClassOf ref:DataObject ;
    skos:definition "Physical serial-numbered machine realizing a logical tool." ;
    ref:standardTerm "PhysicalAsset" ;
    ref:mesDomain "Resource" ;
    ref:isa95Area "Physical Asset" ;
    ref:grounding "ISA" ;
    ref:status "Grounded" .

ref:LoadPort a owl:Class ;
    rdfs:label "Load Port" ;
    rdfs:subClassOf ref:DataObject ;
    skos:definition "Interface where carriers dock onto a tool." ;
    ref:standardTerm "LoadPort" ;
    ref:mesDomain "Resource" ;
    ref:standardAnchor "E87" ;
    ref:grounding "SEMI" ;
    ref:status "Grounded" .

ref:ProductionRequest a owl:Class ;
    rdfs:label "Production Request" ;
    rdfs:subClassOf ref:DataObject ;
    skos:definition "Request to produce a product — the order handed to the MES." ;
    ref:standardTerm "OperationsRequest" ;
    ref:mesDomain "Scheduling" ;
    ref:isa95Area "Operations Schedule" ;
    ref:grounding "ISA" ;
    ref:status "Grounded" .

ref:WorkSchedule a owl:Class ;
    rdfs:label "Work Schedule" ;
    rdfs:subClassOf ref:DataObject ;
    skos:definition "The schedule of work that meets production requests." ;
    ref:standardTerm "OperationsSchedule" ;
    ref:mesDomain "Scheduling" ;
    ref:isa95Area "Operations Schedule" ;
    ref:grounding "ISA" ;
    ref:status "Structure" .

ref:JobOrder a owl:Class ;
    rdfs:label "Job Order" ;
    rdfs:subClassOf ref:DataObject ;
    skos:definition "Lowest-level scheduled unit of work dispatched to a work center." ;
    ref:standardTerm "JobOrder" ;
    ref:mesDomain "Scheduling" ;
    ref:isa95Area "Operations Schedule (Part 4)" ;
    ref:standardAnchor "E94 seam" ;
    ref:grounding "ISA" ;
    ref:status "Grounded" .

ref:JobResponse a owl:Class ;
    rdfs:label "Job Response" ;
    rdfs:subClassOf ref:DataObject ;
    skos:definition "Report on the execution of a job order." ;
    ref:standardTerm "JobResponse" ;
    ref:mesDomain "Scheduling" ;
    ref:isa95Area "Operations Performance (Part 4)" ;
    ref:grounding "ISA" ;
    ref:status "Structure" .

ref:SegmentRequirement a owl:Class ;
    rdfs:label "Segment Requirement" ;
    rdfs:subClassOf ref:DataObject ;
    skos:definition "Line item in the schedule tied to a route step." ;
    ref:standardTerm "SegmentRequirement" ;
    ref:mesDomain "Scheduling" ;
    ref:isa95Area "Operations Schedule (Part 4)" ;
    ref:grounding "ISA" ;
    ref:status "Structure" .

ref:DispatchDecision a owl:Class ;
    rdfs:label "Dispatch Decision" ;
    rdfs:subClassOf ref:DataObject ;
    skos:definition "Record of a dispatch choice: which lot to which tool for which operation, and why. Structural class — populated decisions with timestamps / rule-firing are run: scope." ;
    ref:standardTerm "(dispatch list)" ;
    ref:mesDomain "Scheduling" ;
    ref:isa95Area "Production Dispatching (Part 3)" ;
    ref:grounding "ISA" ;
    ref:status "Structure" .

ref:ControlJob a owl:Class ;
    rdfs:label "Control Job" ;
    rdfs:subClassOf ref:DataObject ;
    skos:definition "Manages the processing sequence for one or more carriers at a tool." ;
    ref:standardTerm "E94 Control Job" ;
    ref:mesDomain "Execution" ;
    ref:standardAnchor "E94" ;
    ref:grounding "SEMI" ;
    ref:status "Grounded" .

ref:ProcessJob a owl:Class ;
    rdfs:label "Process Job" ;
    rdfs:subClassOf ref:DataObject ;
    skos:definition "Process executed on a subset of substrates using a recipe." ;
    ref:standardTerm "E40 Process Job" ;
    ref:mesDomain "Execution" ;
    ref:standardAnchor "E40" ;
    ref:grounding "SEMI" ;
    ref:status "Grounded" .

ref:ProcessStepExecution a owl:Class ;
    rdfs:label "Process Step Execution" ;
    rdfs:subClassOf ref:DataObject ;
    skos:definition "Record of a process step executed on material at equipment." ;
    ref:standardTerm "E157 Process Step Tracking" ;
    ref:mesDomain "Execution" ;
    ref:standardAnchor "E157" ;
    ref:grounding "SEMI" ;
    ref:status "Grounded" .

ref:DataCollectionPlan a owl:Class ;
    rdfs:label "DC Plan" ;
    rdfs:subClassOf ref:DataObject ;
    skos:definition "Defines what data/metrology to collect at a step." ;
    ref:standardTerm "DataCollectionMgmt (E134)" ;
    ref:mesDomain "Quality" ;
    ref:isa95Area "Quality Ops" ;
    ref:standardAnchor "E134" ;
    ref:grounding "SEMI" ;
    ref:status "Grounded" .

ref:SamplingPlan a owl:Class ;
    rdfs:label "Sampling Plan" ;
    rdfs:subClassOf ref:DataObject ;
    skos:definition "Defines whether/which wafers or lots are measured (skip-lot/skip-wafer)." ;
    ref:standardTerm "SamplingPlan" ;
    ref:mesDomain "Quality" ;
    ref:isa95Area "Quality Operations" ;
    ref:grounding "ISA" ;
    ref:status "Structure" .

ref:MeasurementResult a owl:Class ;
    rdfs:label "Measurement Result" ;
    rdfs:subClassOf ref:DataObject ;
    skos:definition "The collected metrology/test data for material at a step." ;
    ref:standardTerm "QualityTestResponse" ;
    ref:mesDomain "Quality" ;
    ref:isa95Area "Quality Test Response (Part 4)" ;
    ref:standardAnchor "E134" ;
    ref:grounding "ISA + SEMI" ;
    ref:status "Structure" .

ref:HoldRecord a owl:Class ;
    rdfs:label "Hold" ;
    rdfs:subClassOf ref:DataObject ;
    skos:definition "Freezes a lot/tool/carrier from further processing on an anomaly." ;
    ref:standardTerm "(exception)" ;
    ref:mesDomain "Quality" ;
    ref:isa95Area "Quality Operations" ;
    ref:grounding "ISA" ;
    ref:status "Derived" .

ref:NonConformanceReport a owl:Class ;
    rdfs:label "NCR" ;
    rdfs:subClassOf ref:DataObject ;
    skos:definition "Formal quality deviation record with MRB disposition. [Promoted to Grounded: CM + Opcenter converge on NCR/MRB as a core object.]" ;
    ref:standardTerm "QualityNonConformance" ;
    ref:mesDomain "Quality" ;
    ref:isa95Area "Quality Operations" ;
    ref:grounding "ISA" ;
    ref:status "Grounded" .

ref:SPCViolation a owl:Class ;
    rdfs:label "SPC Violation" ;
    rdfs:subClassOf ref:DataObject ;
    skos:definition "Out-of-control/out-of-spec event flagged by the SPC engine." ;
    ref:standardTerm "(statistical method)" ;
    ref:mesDomain "Quality" ;
    ref:grounding "ISA" ;
    ref:status "Derived" .

ref:EquipmentStateLog a owl:Class ;
    rdfs:label "Equipment State Log" ;
    rdfs:subClassOf ref:DataObject ;
    skos:definition "Time-stamped history of equipment state changes (basis for RAM/OEE metrics)." ;
    ref:standardTerm "E10 State Log" ;
    ref:mesDomain "Resource" ;
    ref:isa95Area "Equipment" ;
    ref:standardAnchor "E10/E58" ;
    ref:grounding "SEMI" ;
    ref:status "Grounded" .

ref:MaintenanceWorkOrder a owl:Class ;
    rdfs:label "Maintenance Work Order" ;
    rdfs:subClassOf ref:DataObject ;
    skos:definition "Corrective/preventive/calibration ticket on a tool or chamber." ;
    ref:standardTerm "Maintenance Order (Part 4)" ;
    ref:mesDomain "Maintenance" ;
    ref:isa95Area "Maintenance Operations" ;
    ref:standardAnchor "E10 downtime" ;
    ref:grounding "ISA" ;
    ref:status "Structure" .

ref:MaintenanceCounter a owl:Class ;
    rdfs:label "Maintenance Counter" ;
    rdfs:subClassOf ref:DataObject ;
    skos:definition "Usage-based trigger for PM (RF hours, wafer count, cycles)." ;
    ref:standardTerm "MaintenanceCounter" ;
    ref:mesDomain "Maintenance" ;
    ref:isa95Area "Maintenance Resource Mgmt" ;
    ref:grounding "ISA" ;
    ref:status "Derived" .

ref:SparePart a owl:Class ;
    rdfs:label "Spare Part" ;
    rdfs:subClassOf ref:IndirectMaterial ;
    skos:definition "Part replaced during maintenance (focus ring, target, etc.)." ;
    ref:standardTerm "SparePart" ;
    ref:mesDomain "Maintenance" ;
    ref:isa95Area "Maintenance Resource Mgmt" ;
    ref:grounding "ISA" ;
    ref:status "Derived" .

ref:Person a owl:Class ;
    rdfs:label "Person / Operator" ;
    rdfs:subClassOf ref:DataObject ;
    skos:definition "An individual operator, technician or engineer." ;
    ref:standardTerm "Person" ;
    ref:mesDomain "Personnel" ;
    ref:isa95Area "Personnel model" ;
    ref:grounding "ISA" ;
    ref:status "Grounded" .

ref:PersonnelClass a owl:Class ;
    rdfs:label "Personnel Class / Role" ;
    rdfs:subClassOf ref:DataObject ;
    skos:definition "Classification of personnel (operator, technician, engineer)." ;
    ref:standardTerm "PersonnelClass" ;
    ref:mesDomain "Personnel" ;
    ref:isa95Area "Personnel model" ;
    ref:grounding "ISA" ;
    ref:status "Grounded" .

ref:Certification a owl:Class ;
    rdfs:label "Certification" ;
    rdfs:subClassOf ref:DataObject ;
    skos:definition "A qualification a person must hold for a step or resource." ;
    ref:standardTerm "Qualification Test Spec/Result" ;
    ref:mesDomain "Personnel" ;
    ref:isa95Area "Personnel qualification" ;
    ref:grounding "ISA" ;
    ref:status "Structure" .

ref:StorageLocation a owl:Class ;
    rdfs:label "Storage Location / Stocker" ;
    rdfs:subClassOf ref:DataObject ;
    skos:definition "Physical location where material/carriers are stored (stocker, buffer, shelf)." ;
    ref:standardTerm "OperationalLocation" ;
    ref:mesDomain "Inventory" ;
    ref:isa95Area "Inventory Operations" ;
    ref:standardAnchor "E88 stocker" ;
    ref:grounding "ISA + SEMI" ;
    ref:status "Structure" .

ref:MaterialMovement a owl:Class ;
    rdfs:label "Material Movement" ;
    rdfs:subClassOf ref:DataObject ;
    skos:definition "A transfer of material between locations." ;
    ref:standardTerm "MaterialMovement" ;
    ref:mesDomain "Inventory" ;
    ref:isa95Area "Inventory Operations" ;
    ref:standardAnchor "E82/E84 AMHS" ;
    ref:grounding "ISA" ;
    ref:status "Structure" .

ref:InventoryRecord a owl:Class ;
    rdfs:label "Inventory Record" ;
    rdfs:subClassOf ref:DataObject ;
    skos:definition "Stock level / quantity of material at a location." ;
    ref:standardTerm "InventorySnapshot" ;
    ref:mesDomain "Inventory" ;
    ref:isa95Area "Inventory Operations" ;
    ref:grounding "ISA" ;
    ref:status "Derived" .

ref:Material a owl:Class ;
    rdfs:label "Material" ;
    rdfs:subClassOf ref:DataObject ;
    skos:definition "Abstract superclass — any tracked material (product/consumable/durable/indirect); NEVER instantiated directly, every real material is a leaf. A HUB: bound by BOM/segment spec; related to Step, Equipment, Maintenance, Inventory, Dispatch, and other Material (genealogy)." ;
    ref:standardTerm "Material (ISA-95 model)" ;
    ref:mesDomain "Material" ;
    ref:isa95Area "Material Model" ;
    ref:grounding "ISA" ;
    ref:manufacturingStage "FullFlow" ;
    ref:status "Grounded" .

ref:ProductMaterial a owl:Class ;
    rdfs:label "Product Material" ;
    rdfs:subClassOf ref:Material ;
    skos:definition "Physical WIP product at any form. definedBy a Product. DISTINCT from the Product device-definition object. One class, many forms: wafer -> die -> package." ;
    ref:standardTerm "MaterialLot / Sublot" ;
    ref:mesDomain "Material" ;
    ref:isa95Area "Material" ;
    ref:grounding "ISA" ;
    ref:manufacturingStage "FullFlow" ;
    ref:status "Grounded" .

ref:Die a owl:Class ;
    rdfs:label "Die" ;
    rdfs:subClassOf ref:ProductMaterial ;
    skos:definition "Singulated die. Carries source-wafer position (gridX/Y), stackTier (3D), binCategory, KGD state. Identity ORIGINATES as a WaferMap entry before it is physical at dicing." ;
    ref:standardTerm "Material Sublot (extended)" ;
    ref:mesDomain "Material" ;
    ref:isa95Area "Material Sublot" ;
    ref:standardAnchor "E90/E142 (ext)" ;
    ref:grounding "ISA + SEMI" ;
    ref:manufacturingStage "CrossStage" ;
    ref:status "Structure" .

ref:Package a owl:Class ;
    rdfs:label "Package / Unit" ;
    rdfs:subClassOf ref:ProductMaterial ;
    skos:definition "Assembled unit containing one or more dies (+ interposer + package substrate). Multi-die = advanced packaging (chiplet/2.5D/3D/HBM)." ;
    ref:standardTerm "(assembly)" ;
    ref:mesDomain "Material" ;
    ref:grounding "—" ;
    ref:manufacturingStage "AP" ;
    ref:status "Derived" .

ref:Module a owl:Class ;
    rdfs:label "Module / SiP" ;
    rdfs:subClassOf ref:ProductMaterial ;
    skos:definition "Higher-level assembled unit containing one or more packages (System-in-Package). Top of the containment hierarchy." ;
    ref:standardTerm "(advanced packaging)" ;
    ref:mesDomain "Material" ;
    ref:grounding "—" ;
    ref:manufacturingStage "AP" ;
    ref:status "Derived" .

ref:Interposer a owl:Class ;
    rdfs:label "Interposer" ;
    rdfs:subClassOf ref:ProductMaterial ;
    skos:definition "2.5D interposer (Si/organic/glass) that dies sit on; own fab genealogy. Assembly constituent alongside dies." ;
    ref:standardTerm "(advanced packaging)" ;
    ref:mesDomain "Material" ;
    ref:grounding "—" ;
    ref:manufacturingStage "AP" ;
    ref:status "Derived" .

ref:PackageSubstrate a owl:Class ;
    rdfs:label "Package Substrate / Laminate" ;
    rdfs:subClassOf ref:ProductMaterial ;
    skos:definition "Organic/laminate substrate the interposer/dies mount to. Constituent. NOT a wafer (E90), NOT a Carrier (E87)." ;
    ref:standardTerm "(advanced packaging)" ;
    ref:mesDomain "Material" ;
    ref:grounding "—" ;
    ref:manufacturingStage "AP" ;
    ref:status "Derived" .

ref:ConsumableMaterial a owl:Class ;
    rdfs:label "Consumable Material" ;
    rdfs:subClassOf ref:Material ;
    skos:definition "Consumed during processing (resist, slurry, gases, DAF tape). Lot/qty tracked with expiry, vendor lot, CoA, grade." ;
    ref:standardTerm "Material (Consumed use)" ;
    ref:mesDomain "Material" ;
    ref:isa95Area "Material" ;
    ref:grounding "ISA" ;
    ref:manufacturingStage "FullFlow" ;
    ref:status "Grounded" .

ref:DurableMaterial a owl:Class ;
    rdfs:label "Durable Material" ;
    rdfs:subClassOf ref:Material ;
    skos:definition "Reusable tooling carrying process identity (reticle/mask, probe card, test board). Serial + floor-life counter + qualification. loadedInto Equipment; maintained like equipment." ;
    ref:standardTerm "(segment resource requirement)" ;
    ref:mesDomain "Material" ;
    ref:isa95Area "Material" ;
    ref:grounding "ISA" ;
    ref:manufacturingStage "FullFlow" ;
    ref:status "Structure" .

ref:IndirectMaterial a owl:Class ;
    rdfs:label "Indirect Material" ;
    rdfs:subClassOf ref:Material ;
    skos:definition "MRO / maintenance supplies (spare parts). SparePart re-classed under here. Consumed by maintenance, not production." ;
    ref:standardTerm "Material (MRO)" ;
    ref:mesDomain "Material" ;
    ref:isa95Area "Material" ;
    ref:grounding "ISA" ;
    ref:manufacturingStage "FullFlow" ;
    ref:status "Structure" .

ref:AssemblyCarrier a owl:Class ;
    rdfs:label "Assembly Carrier (Strip / Lead-frame)" ;
    rdfs:subClassOf ref:DataObject ;
    skos:definition "Strip / lead-frame / boat holding many packages at positions during assembly & test — back-end analog of a FOUP+slot. OSAT-scope; front-end-only comparison can omit." ;
    ref:standardTerm "(E90 sub-substrate analog)" ;
    ref:mesDomain "Material" ;
    ref:standardAnchor "E90 (analog)" ;
    ref:grounding "SEMI" ;
    ref:manufacturingStage "BE" ;
    ref:status "Derived" .

ref:Defect a owl:Class ;
    rdfs:label "Defect" ;
    rdfs:subClassOf ref:DataObject ;
    skos:definition "Categorical, coded, located quality finding (visual / ADC / inline inspection). Distinct from MeasurementResult (parametric value vs limit): a PRIMARY observation that may exist with no parametric result behind it. CM + Opcenter converge." ;
    ref:standardTerm "(quality finding)" ;
    ref:mesDomain "Quality" ;
    ref:isa95Area "Quality Operations" ;
    ref:standardAnchor "E142 (defect/bin)" ;
    ref:grounding "ISA + SEMI" ;
    ref:manufacturingStage "CrossStage" ;
    ref:status "Grounded" .

# ===== CAPABILITIES =====
ref:MasterDataManagement a owl:Class ;
    rdfs:subClassOf ref:Capability ;
    rdfs:label "Master Data Management" ;
    skos:definition "Maintaining definition-plane objects (products, routes, recipes, resources)." ;
    ref:standardAnchor "ISA-95" ;
    ref:grounding "ISA" ;
    ref:status "Derived" ;
    ref:operatesOnRaw "All definition-plane objects" ;
    rdfs:comment "CROSS-CUTTING — function over objects" .

ref:RoutingDefinition a owl:Class ;
    rdfs:subClassOf ref:Capability ;
    rdfs:label "Routing / Process Definition" ;
    skos:definition "Authoring routes and steps and their sequence." ;
    ref:standardAnchor "ISA-95 Product Definition Mgmt" ;
    ref:grounding "ISA" ;
    ref:status "Grounded" ;
    ref:operatesOnRaw "Route, Route Operation, Step, Q-Time Constraint, Rework Path" ;
    ref:operatesOn ref:ReworkPath, ref:Route, ref:RouteOperation, ref:Step, ref:TimeConstraint ;
    rdfs:comment "Built" .

ref:OrderManagement a owl:Class ;
    rdfs:subClassOf ref:Capability ;
    rdfs:label "Order Management" ;
    skos:definition "Managing production requests / work orders." ;
    ref:standardAnchor "ISA-95 Production Schedule/Request" ;
    ref:grounding "ISA" ;
    ref:status "Built (structure)" ;
    ref:operatesOnRaw "Production Request, Work Schedule, Job Order" ;
    ref:operatesOn ref:JobOrder, ref:ProductionRequest, ref:WorkSchedule ;
    rdfs:comment "Scheduling slice — now has nouns" .

ref:MaterialTracking a owl:Class ;
    rdfs:subClassOf ref:Capability ;
    rdfs:label "Material / Lot Tracking" ;
    skos:definition "Tracking lots and substrates through the flow." ;
    ref:standardAnchor "ISA-95 Material; SEMI E90" ;
    ref:grounding "ISA + SEMI" ;
    ref:status "Grounded" ;
    ref:operatesOnRaw "Lot, Substrate, Material, ProductMaterial, Die, Package, Module, Interposer, PackageSubstrate, WaferMap, AssemblyCarrier" ;
    ref:operatesOn ref:AssemblyCarrier, ref:Die, ref:Interposer, ref:Lot, ref:Material, ref:Module, ref:Package, ref:PackageSubstrate, ref:ProductMaterial, ref:Substrate, ref:WaferMap ;
    rdfs:comment "C4 — expanded to the material hub. Consumable/Durable/Indirect are cross-cutting hub materials operated on by Routing (segmentRequiresMaterial/consumes/produces), Maintenance (maintains/maintenanceConsumes) and Dispatch (reservesMaterial) — not owned by one capability." .

ref:CarrierManagement a owl:Class ;
    rdfs:subClassOf ref:Capability ;
    rdfs:label "Carrier Management" ;
    skos:definition "Managing carriers and their docking/loading." ;
    ref:standardAnchor "SEMI E87" ;
    ref:grounding "SEMI" ;
    ref:status "Grounded" ;
    ref:operatesOnRaw "Carrier, Load Port" ;
    ref:operatesOn ref:Carrier, ref:LoadPort ;
    rdfs:comment "Built" .

ref:Dispatch a owl:Class ;
    rdfs:subClassOf ref:Capability ;
    rdfs:label "Dispatch" ;
    skos:definition "Selecting/releasing the next lot/step to a resource." ;
    ref:standardAnchor "ISA-95 Production Dispatching" ;
    ref:grounding "ISA" ;
    ref:status "Built (structure)" ;
    ref:operatesOnRaw "Job Order, Lot, Equipment, Dispatch Decision" ;
    ref:operatesOn ref:DispatchDecision, ref:Equipment, ref:JobOrder, ref:Lot ;
    rdfs:comment "Scheduling slice — now has nouns" .

ref:Execution a owl:Class ;
    rdfs:subClassOf ref:Capability ;
    rdfs:label "Execution (Track In->Run)" ;
    skos:definition "Running material at a step on equipment." ;
    ref:standardAnchor "SEMI E40/E94/E157; ISA-95 Production Execution" ;
    ref:grounding "SEMI" ;
    ref:status "Built" ;
    ref:operatesOnRaw "Control Job, Process Job, Process Step Execution, Lot" ;
    ref:operatesOn ref:ControlJob, ref:Lot, ref:ProcessJob, ref:ProcessStepExecution ;
    rdfs:comment "Execution slice — now built" .

ref:EquipmentTracking a owl:Class ;
    rdfs:subClassOf ref:Capability ;
    rdfs:label "Equipment Tracking" ;
    skos:definition "Tracking equipment availability and state." ;
    ref:standardAnchor "ISA-95 Equipment; SEMI E10/E58" ;
    ref:grounding "ISA + SEMI" ;
    ref:status "Built" ;
    ref:operatesOnRaw "Equipment, Equipment State Log" ;
    ref:operatesOn ref:Equipment, ref:EquipmentStateLog ;
    rdfs:comment "Resource slice — now built" .

ref:RecipeManagement a owl:Class ;
    rdfs:subClassOf ref:Capability ;
    rdfs:label "Recipe Management" ;
    skos:definition "Managing recipes executed at steps." ;
    ref:standardAnchor "SEMI E40/E42/E139" ;
    ref:grounding "SEMI" ;
    ref:status "Grounded" ;
    ref:operatesOnRaw "Recipe" ;
    ref:operatesOn ref:Recipe ;
    rdfs:comment "Built (structure)" .

ref:DataCollection a owl:Class ;
    rdfs:subClassOf ref:Capability ;
    rdfs:label "Data Collection" ;
    skos:definition "Defining data collected at a step." ;
    ref:standardAnchor "ISA-95 Production Data Collection; SEMI E134" ;
    ref:grounding "ISA + SEMI" ;
    ref:status "Built" ;
    ref:operatesOnRaw "DC Plan, Sampling Plan, Measurement Result" ;
    ref:operatesOn ref:DataCollectionPlan, ref:MeasurementResult, ref:SamplingPlan ;
    rdfs:comment "Quality slice — now built Feeds QualityManagement; E134 collection is production-side data gathering, distinct from quality evaluation." .

ref:QualityManagement a owl:Class ;
    rdfs:subClassOf ref:Capability ;
    rdfs:label "Quality Management" ;
    skos:definition "Quality operations — specifications, inspection findings, SPC, holds, non-conformance & disposition, and defect classification." ;
    ref:standardAnchor "ISA-95 Quality Operations Mgmt; SEMI E142" ;
    ref:grounding "ISA + SEMI" ;
    ref:status "Grounded" ;
    ref:operatesOnRaw "TestSpec, Hold, NCR, SPC Violation, Defect" ;
    ref:operatesOn ref:Defect, ref:HoldRecord, ref:NonConformanceReport, ref:SPCViolation, ref:TestSpec ;
    rdfs:comment "Absorbs former ExceptionManagement (holds/NCR/SPC). DataCollection remains the production-side data feed (E134) that Quality evaluates." .

ref:Genealogy a owl:Class ;
    rdfs:subClassOf ref:Capability ;
    rdfs:label "Genealogy" ;
    skos:definition "Tracing material/equipment relationships over time." ;
    ref:standardAnchor "ISA-95 Material Lot genealogy" ;
    ref:grounding "ISA" ;
    ref:status "Grounded" ;
    ref:operatesOnRaw "Lot, Substrate, Equipment" ;
    ref:operatesOn ref:Equipment, ref:Lot, ref:Substrate ;
    rdfs:comment "CROSS-CUTTING — traceability" .

ref:MaintenanceManagement a owl:Class ;
    rdfs:subClassOf ref:Capability ;
    rdfs:label "Maintenance Management" ;
    skos:definition "Managing maintenance work orders, PM triggers and spare parts." ;
    ref:standardAnchor "ISA-95 Maintenance Operations Mgmt; SEMI E10" ;
    ref:grounding "ISA + SEMI" ;
    ref:status "Built" ;
    ref:operatesOnRaw "Maintenance Work Order, Maintenance Counter, Spare Part, Equipment" ;
    ref:operatesOn ref:Equipment, ref:MaintenanceCounter, ref:MaintenanceWorkOrder, ref:SparePart ;
    rdfs:comment "NEW capability — beyond original 12" .

ref:PersonnelManagement a owl:Class ;
    rdfs:subClassOf ref:Capability ;
    rdfs:label "Personnel / Labor Management" ;
    skos:definition "Managing operators, roles and certifications." ;
    ref:standardAnchor "ISA-95 Personnel model (Part 2)" ;
    ref:grounding "ISA" ;
    ref:status "Built" ;
    ref:operatesOnRaw "Person, Personnel Class, Certification" ;
    ref:operatesOn ref:Certification, ref:Person, ref:PersonnelClass ;
    rdfs:comment "NEW capability — beyond original 12" .

ref:InventoryManagement a owl:Class ;
    rdfs:subClassOf ref:Capability ;
    rdfs:label "Inventory / Material Logistics" ;
    skos:definition "Managing WIP locations, material movement and stock levels." ;
    ref:standardAnchor "ISA-95 Inventory Operations Mgmt; SEMI E82/E88" ;
    ref:grounding "ISA + SEMI" ;
    ref:status "Built" ;
    ref:operatesOnRaw "Storage Location, Material Movement, Inventory Record, Lot" ;
    ref:operatesOn ref:InventoryRecord, ref:Lot, ref:MaterialMovement, ref:StorageLocation ;
    rdfs:comment "NEW capability — beyond original 12" .

# ===== DATA PROPERTIES =====
ref:lotID a owl:DatatypeProperty ;
    rdfs:label "LotID" ;
    rdfs:domain ref:Lot ;
    rdfs:range xsd:string ;
    ref:valueKind "plain" ;
    ref:grounding "ISA" ;
    rdfs:comment "" .

ref:quantity a owl:DatatypeProperty ;
    rdfs:label "Quantity" ;
    rdfs:domain ref:Lot ;
    rdfs:range xsd:decimal ;
    ref:valueKind "plain" ;
    ref:grounding "ISA" ;
    rdfs:comment "Wafer/die count" .

ref:lotStatus a owl:ObjectProperty ;
    rdfs:label "Lot Status" ;
    rdfs:domain ref:Lot ;
    rdfs:range ref:LotStatus ;
    ref:valueKind "lookup" ;
    ref:grounding "ISA" ;
    rdfs:comment "WIP/Hold/Scrap" .

