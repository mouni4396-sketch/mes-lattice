    rdfs:label "Defect ID" ;
    rdfs:domain ref:Defect ;
    rdfs:range xsd:string ;
    ref:valueKind "plain" ;
    ref:grounding "—" ;
    rdfs:comment "Structure. Vendor/inspection defect identifier." .

ref:defectSeverity a owl:DatatypeProperty ;
    rdfs:label "Defect Severity" ;
    rdfs:domain ref:Defect ;
    rdfs:range xsd:string ;
    ref:valueKind "plain" ;
    ref:grounding "—" ;
    rdfs:comment "Structure. Severity / criticality (killer / major / minor)." .

ref:defectCount a owl:DatatypeProperty ;
    rdfs:label "Defect Count" ;
    rdfs:domain ref:Defect ;
    rdfs:range xsd:integer ;
    ref:valueKind "plain" ;
    ref:grounding "—" ;
    rdfs:comment "Structure. Number of occurrences aggregated in this record." .

ref:defectDensity a owl:DatatypeProperty ;
    rdfs:label "Defect Density" ;
    rdfs:domain ref:Defect ;
    rdfs:range xsd:decimal ;
    ref:valueKind "plain" ;
    ref:grounding "—" ;
    rdfs:comment "Structure. Defects per unit area (e.g. /cm2) — killer-defect / yield analytics." .

ref:dispositionAction a owl:DatatypeProperty ;
    rdfs:label "Disposition Action" ;
    rdfs:domain ref:Defect ;
    rdfs:range ref:DispositionAction ;
    ref:valueKind "enum" ;
    ref:grounding "ISA" ;
    rdfs:comment "Reuses the neutral disposition enum (vendor disposition codes map up in the overlay)." .

# ===== OBJECT PROPERTIES =====
ref:definedBy a owl:ObjectProperty ;
    rdfs:label "definedBy" ;
    rdfs:domain [ owl:unionOf ( ref:Lot ref:ProductMaterial ) ] ;
    rdfs:range ref:Product ;
    ref:cardinality "1" ;
    ref:grounding "ISA" ;
    rdfs:comment "A3 — union domain: both the batch (Lot) and the individual material (ProductMaterial/Substrate/Die) are defined by a Product." .

ref:onRoute a owl:ObjectProperty ;
    rdfs:label "onRoute" ;
    rdfs:domain ref:Lot ;
    rdfs:range ref:Route ;
    ref:cardinality "0..1" ;
    ref:grounding "ISA" ;
    rdfs:comment "The route this lot is ACTUALLY running (defaults to the product's route; diverges for rework/alternates)" .

ref:atRouteOperation a owl:ObjectProperty ;
    rdfs:label "atRouteOperation" ;
    rdfs:domain ref:Lot ;
    rdfs:range ref:RouteOperation ;
    ref:cardinality "0..1" ;
    ref:grounding "ISA" ;
    rdfs:comment "The lot's CURRENT position in the route — live WIP pointer" .

ref:classifiedBy a owl:ObjectProperty ;
    rdfs:label "classifiedBy" ;
    rdfs:domain ref:Equipment ;
    rdfs:range ref:EquipmentGroup ;
    ref:cardinality "0..*" ;
    ref:grounding "ISA" ;
    rdfs:comment "Class membership" .

ref:composedOf a owl:ObjectProperty ;
    rdfs:label "composedOf" ;
    rdfs:domain ref:Lot ;
    rdfs:range ref:ProductMaterial ;
    owl:inverseOf ref:partOfLot ;
    ref:cardinality "0..*" ;
    ref:grounding "ISA + SEMI" ;
    rdfs:comment "A4 — range widened Substrate -> ProductMaterial so a lot can aggregate any form (wafers/dies/units). Inverse partOfLot widens too. TREE genealogy (front-end)." .

ref:splitFrom a owl:ObjectProperty ;
    rdfs:label "splitFrom" ;
    rdfs:domain ref:Lot ;
    rdfs:range ref:Lot ;
    ref:cardinality "0..1" ;
    ref:grounding "ISA" ;
    rdfs:comment "Parent lot this lot was split from (engineering split / send-ahead). ISA-95 material lot genealogy" .

ref:mergedFrom a owl:ObjectProperty ;
    rdfs:label "mergedFrom" ;
    rdfs:domain ref:Lot ;
    rdfs:range ref:Lot ;
    ref:cardinality "0..*" ;
    ref:grounding "ISA" ;
    rdfs:comment "Lots that merged to form this lot. ISA-95 material lot genealogy" .

ref:locatedInCarrier a owl:ObjectProperty ;
    rdfs:label "locatedInCarrier" ;
    rdfs:domain ref:Substrate ;
    rdfs:range ref:Carrier ;
    owl:inverseOf ref:containsSubstrate ;
    ref:cardinality "0..1" ;
    ref:grounding "SEMI" ;
    rdfs:comment "Slot occupancy E87/E90. Inverse containsSubstrate lets carrier-first queries traverse to its wafers" .

ref:dockedAt a owl:ObjectProperty ;
    rdfs:label "dockedAt" ;
    rdfs:domain ref:Carrier ;
    rdfs:range ref:LoadPort ;
    owl:inverseOf ref:hostsCarrier ;
    ref:cardinality "0..1" ;
    ref:grounding "SEMI" ;
    rdfs:comment "E87. Inverse hostsCarrier: load-port-first traversal" .

ref:hasMap a owl:ObjectProperty ;
    rdfs:label "hasMap" ;
    rdfs:domain ref:Substrate ;
    rdfs:range ref:WaferMap ;
    owl:inverseOf ref:mapsWafer ;
    ref:cardinality "0..1" ;
    ref:grounding "SEMI" ;
    rdfs:comment "E142" .

ref:includesOperation a owl:ObjectProperty ;
    rdfs:label "includesOperation" ;
    rdfs:domain ref:Route ;
    rdfs:range ref:RouteOperation ;
    owl:inverseOf ref:partOfRoute ;
    ref:cardinality "1..*" ;
    ref:grounding "ISA" ;
    rdfs:comment "Ordered placements" .

ref:partOfRoute a owl:ObjectProperty ;
    rdfs:label "partOfRoute" ;
    rdfs:domain ref:RouteOperation ;
    rdfs:range ref:Route ;
    owl:inverseOf ref:includesOperation ;
    ref:cardinality "1" ;
    ref:grounding "ISA" ;
    rdfs:comment "Inverse of includesOperation — lets a query traverse operation -> route (needed to express the atRouteOperation/onRoute consistency check)" .

ref:realizes a owl:ObjectProperty ;
    rdfs:label "realizes" ;
    rdfs:domain ref:RouteOperation ;
    rdfs:range ref:Step ;
    ref:cardinality "1" ;
    ref:grounding "ISA" ;
    rdfs:comment "Placement realizes generic step (= CM Flow Item)" .

ref:precedes a owl:ObjectProperty ;
    rdfs:label "precedes" ;
    rdfs:domain ref:RouteOperation ;
    rdfs:range ref:RouteOperation ;
    ref:cardinality "0..*" ;
    ref:grounding "ISA" ;
    rdfs:comment "ISA-95 segment precedence — the operation(s) that follow this one. Traversable flow (linear = one successor; branching = many, for parallel/conditional paths). 'nextOperation' is the linear read of this." .

ref:hasBOM a owl:ObjectProperty ;
    rdfs:label "hasBOM" ;
    rdfs:domain ref:Product ;
    rdfs:range ref:BOM ;
    ref:cardinality "0..1" ;
    ref:grounding "ISA" ;
    rdfs:comment "A1 — repointed from Route to Product; the BOM binds the device SKU. specifiesMaterial carries the lines." .

ref:produces a owl:ObjectProperty ;
    rdfs:label "produces" ;
    rdfs:domain ref:Route ;
    rdfs:range ref:Product ;
    ref:cardinality "1" ;
    ref:grounding "ISA" ;
    rdfs:comment "NEW — Route makes this product" .

ref:requiresSpecification a owl:ObjectProperty ;
    rdfs:label "requiresSpecification" ;
    rdfs:domain ref:Step ;
    rdfs:range ref:ProcessSpecification ;
    ref:cardinality "0..*" ;
    ref:grounding "ISA" ;
    rdfs:comment "ISA-95 Process Segment specifications (resource specs the step requires)" .

ref:requiresEquipmentGroup a owl:ObjectProperty ;
    rdfs:label "requiresEquipmentGroup" ;
    rdfs:domain ref:Step ;
    rdfs:range ref:EquipmentGroup ;
    ref:cardinality "0..*" ;
    ref:grounding "ISA" ;
    rdfs:comment "ISA-95 Process Segment Equipment Specification — the eligible tool CLASS for this step (definitional; dispatch picks the specific tool). Distinct from ProcessStepExecution.executedOn (the actual tool)" .

ref:executesRecipe a owl:ObjectProperty ;
    rdfs:label "executesRecipe" ;
    rdfs:domain ref:Step ;
    rdfs:range ref:Recipe ;
    ref:cardinality "0..1" ;
    ref:grounding "SEMI" ;
    rdfs:comment "E40 reference" .

ref:realizedBy a owl:ObjectProperty ;
    rdfs:label "realizedBy" ;
    rdfs:domain ref:Equipment ;
    rdfs:range ref:PhysicalEquipment ;
    ref:cardinality "0..*" ;
    ref:grounding "ISA" ;
    rdfs:comment "Historized (AssetAssignment reified)" .

ref:partOf a owl:ObjectProperty ;
    rdfs:label "partOf" ;
    rdfs:domain ref:Equipment ;
    rdfs:range ref:Equipment ;
    ref:cardinality "0..1" ;
    ref:grounding "ISA" ;
    rdfs:comment "Hierarchy (level = enum)" .

ref:hasLoadPort a owl:ObjectProperty ;
    rdfs:label "hasLoadPort" ;
    rdfs:domain ref:Equipment ;
    rdfs:range ref:LoadPort ;
    owl:inverseOf ref:mountedOn ;
    ref:cardinality "0..*" ;
    ref:grounding "SEMI" ;
    rdfs:comment "E87 — load port is an interface on the tool" .

ref:testedBy a owl:ObjectProperty ;
    rdfs:label "testedBy" ;
    rdfs:domain [ owl:unionOf ( ref:Product ref:Lot ref:Substrate ) ] ;
    rdfs:range ref:TestSpec ;
    ref:cardinality "0..*" ;
    ref:grounding "ISA" ;
    rdfs:comment "Test spec applies to product/lot/substrate" .

ref:fromOperation a owl:ObjectProperty ;
    rdfs:label "fromOperation" ;
    rdfs:domain ref:TimeConstraint ;
    rdfs:range ref:RouteOperation ;
    ref:cardinality "1" ;
    ref:grounding "ISA" ;
    rdfs:comment "Start of the timed interval" .

ref:toOperation a owl:ObjectProperty ;
    rdfs:label "toOperation" ;
    rdfs:domain ref:TimeConstraint ;
    rdfs:range ref:RouteOperation ;
    ref:cardinality "1" ;
    ref:grounding "ISA" ;
    rdfs:comment "End of the timed interval (Q-time measured from->to)" .

ref:hasReworkPath a owl:ObjectProperty ;
    rdfs:label "hasReworkPath" ;
    rdfs:domain ref:RouteOperation ;
    rdfs:range ref:ReworkPath ;
    ref:cardinality "0..*" ;
    ref:grounding "ISA" ;
    rdfs:comment "Rework options at this operation" .

ref:reworkGoTo a owl:ObjectProperty ;
    rdfs:label "reworkGoTo" ;
    rdfs:domain ref:ReworkPath ;
    rdfs:range ref:RouteOperation ;
    ref:cardinality "1" ;
    ref:grounding "ISA" ;
    rdfs:comment "Where rework processing starts" .

ref:reworkReturn a owl:ObjectProperty ;
    rdfs:label "reworkReturn" ;
    rdfs:domain ref:ReworkPath ;
    rdfs:range ref:RouteOperation ;
    ref:cardinality "1" ;
    ref:grounding "ISA" ;
    rdfs:comment "Where the lot rejoins the main route" .

ref:executedForSubstrate a owl:ObjectProperty ;
    rdfs:label "executedForSubstrate" ;
    rdfs:domain ref:ProcessStepExecution ;
    rdfs:range ref:Substrate ;
    ref:cardinality "0..*" ;
    ref:grounding "SEMI" ;
    rdfs:comment "Wafer-level execution genealogy (partial-lot processing)" .

ref:executedVia a owl:ObjectProperty ;
    rdfs:label "executedVia" ;
    rdfs:domain ref:ProcessStepExecution ;
    rdfs:range ref:ProcessJob ;
    ref:cardinality "0..1" ;
    ref:grounding "SEMI" ;
    rdfs:comment "The E40 process job that actually ran this step execution — links the MES execution record (E157) to the equipment-level job (E40)" .

ref:collectedDuring a owl:ObjectProperty ;
    rdfs:label "collectedDuring" ;
    rdfs:domain ref:MeasurementResult ;
    rdfs:range ref:ProcessStepExecution ;
    ref:cardinality "0..1" ;
    ref:grounding "SEMI" ;
    rdfs:comment "Ties the data trace to the specific execution run (RCA/GenAI feed)" .

ref:fulfills a owl:ObjectProperty ;
    rdfs:label "fulfills" ;
    rdfs:domain ref:WorkSchedule ;
    rdfs:range ref:ProductionRequest ;
    ref:cardinality "0..*" ;
    ref:grounding "ISA" ;
    rdfs:comment "Schedule meets the request" .

ref:includesJobOrder a owl:ObjectProperty ;
    rdfs:label "includesJobOrder" ;
    rdfs:domain ref:WorkSchedule ;
    rdfs:range ref:JobOrder ;
    owl:inverseOf ref:partOfSchedule ;
    ref:cardinality "1..*" ;
    ref:grounding "ISA" ;
    rdfs:comment "Schedule is made of job orders" .

ref:usesWorkMaster a owl:ObjectProperty ;
    rdfs:label "usesWorkMaster" ;
    rdfs:domain ref:JobOrder ;
    rdfs:range ref:Route ;
    ref:cardinality "1" ;
    ref:grounding "ISA" ;
    rdfs:comment "Job order follows a Work Master = Route (links scheduling to routing)" .

ref:dispatchedTo a owl:ObjectProperty ;
    rdfs:label "dispatchedTo" ;
    rdfs:domain ref:JobOrder ;
    rdfs:range ref:Equipment ;
    ref:cardinality "0..1" ;
    ref:grounding "ISA" ;
    rdfs:comment "Job order dispatched to a work center / tool" .

ref:schedulesLot a owl:ObjectProperty ;
    rdfs:label "schedulesLot" ;
    rdfs:domain ref:JobOrder ;
    rdfs:range ref:Lot ;
    ref:cardinality "0..*" ;
    ref:grounding "ISA + SEMI" ;
    rdfs:comment "The material the job order runs" .

ref:respondsTo a owl:ObjectProperty ;
    rdfs:label "respondsTo" ;
    rdfs:domain ref:JobResponse ;
    rdfs:range ref:JobOrder ;
    ref:cardinality "1" ;
    ref:grounding "ISA" ;
    rdfs:comment "Response reports on a job order" .

ref:forLot a owl:ObjectProperty ;
    rdfs:label "forLot" ;
    rdfs:domain ref:DispatchDecision ;
    rdfs:range ref:Lot ;
    ref:cardinality "1" ;
    ref:grounding "ISA" ;
    rdfs:comment "The lot that was dispatched" .

ref:toEquipment a owl:ObjectProperty ;
    rdfs:label "toEquipment" ;
    rdfs:domain ref:DispatchDecision ;
    rdfs:range ref:Equipment ;
    ref:cardinality "1" ;
    ref:grounding "ISA" ;
    rdfs:comment "The tool it was dispatched to" .

ref:forJobOrder a owl:ObjectProperty ;
    rdfs:label "forJobOrder" ;
    rdfs:domain ref:DispatchDecision ;
    rdfs:range ref:JobOrder ;
    ref:cardinality "0..1" ;
    ref:grounding "ISA" ;
    rdfs:comment "The job order this decision serves" .

ref:dispatchesOperation a owl:ObjectProperty ;
    rdfs:label "dispatchesOperation" ;
    rdfs:domain ref:DispatchDecision ;
    rdfs:range ref:RouteOperation ;
    ref:cardinality "1" ;
    ref:grounding "ISA" ;
    rdfs:comment "Dispatch is STEP-SPECIFIC — the operation being dispatched, not the whole route" .

ref:requestsProduct a owl:ObjectProperty ;
    rdfs:label "requestsProduct" ;
    rdfs:domain ref:ProductionRequest ;
    rdfs:range ref:Product ;
    ref:cardinality "1" ;
    ref:grounding "ISA" ;
    rdfs:comment "What the request is to produce (direct product link; previously only reachable via a 3-hop path)" .

ref:requiresOperation a owl:ObjectProperty ;
    rdfs:label "requiresOperation" ;
    rdfs:domain ref:SegmentRequirement ;
    rdfs:range ref:RouteOperation ;
    ref:cardinality "0..1" ;
    ref:grounding "ISA" ;
    rdfs:comment "Segment requirement ties to a route step" .

ref:handsOffTo a owl:ObjectProperty ;
    rdfs:label "handsOffTo" ;
    rdfs:domain ref:JobOrder ;
    rdfs:range ref:ControlJob ;
    ref:cardinality "0..1" ;
    ref:grounding "SEMI" ;
    rdfs:comment "EXECUTION SEAM: Job Order -> E94 Control Job" .

ref:manages a owl:ObjectProperty ;
    rdfs:label "manages" ;
    rdfs:domain ref:ControlJob ;
    rdfs:range ref:ProcessJob ;
    owl:inverseOf ref:partOfControlJob ;
    ref:cardinality "1..*" ;
    ref:grounding "SEMI" ;
    rdfs:comment "E94 -> E40 execution hierarchy" .

ref:processesSubstrate a owl:ObjectProperty ;
    rdfs:label "processesSubstrate" ;
    rdfs:domain ref:ProcessJob ;
    rdfs:range ref:Substrate ;
    ref:cardinality "1..*" ;
    ref:grounding "SEMI" ;
    rdfs:comment "E40 runs on a subset of substrates" .

ref:runsRecipe a owl:ObjectProperty ;
    rdfs:label "runsRecipe" ;
    rdfs:domain ref:ProcessJob ;
    rdfs:range ref:Recipe ;
    ref:cardinality "1" ;
    ref:grounding "SEMI" ;
    rdfs:comment "E40 process job executes a recipe" .

ref:processesCarrier a owl:ObjectProperty ;
    rdfs:label "processesCarrier" ;
    rdfs:domain ref:ControlJob ;
    rdfs:range ref:Carrier ;
    ref:cardinality "1..*" ;
    ref:grounding "SEMI" ;
    rdfs:comment "E94 manages carriers" .

ref:recordsStep a owl:ObjectProperty ;
    rdfs:label "recordsStep" ;
    rdfs:domain ref:ProcessStepExecution ;
    rdfs:range ref:Step ;
    ref:cardinality "1" ;
    ref:grounding "SEMI" ;
    rdfs:comment "E157 — execution record of a route step (generic)" .

ref:executesOperation a owl:ObjectProperty ;
    rdfs:label "executesOperation" ;
    rdfs:domain ref:ProcessStepExecution ;
    rdfs:range ref:RouteOperation ;
    ref:cardinality "1" ;
    ref:grounding "ISA + SEMI" ;
    rdfs:comment "Ties the execution to the SPECIFIC route placement (precise genealogy; the RouteOperation realizes the generic Step)" .

ref:executedOn a owl:ObjectProperty ;
    rdfs:label "executedOn" ;
    rdfs:domain ref:ProcessStepExecution ;
    rdfs:range ref:Equipment ;
    ref:cardinality "1" ;
    ref:grounding "SEMI" ;
    rdfs:comment "Where the step ran (genealogy)" .

ref:executedForLot a owl:ObjectProperty ;
    rdfs:label "executedForLot" ;
    rdfs:domain ref:ProcessStepExecution ;
    rdfs:range ref:Lot ;
    ref:cardinality "0..1" ;
    ref:grounding "SEMI" ;
    rdfs:comment "Material processed (genealogy)" .

ref:collectsAtStep a owl:ObjectProperty ;
    rdfs:label "collectsAtStep" ;
    rdfs:domain ref:DataCollectionPlan ;
    rdfs:range ref:Step ;
    ref:cardinality "0..*" ;
    ref:grounding "SEMI" ;
    rdfs:comment "DC plan defined at a step" .

ref:samplesAtStep a owl:ObjectProperty ;
    rdfs:label "samplesAtStep" ;
    rdfs:domain ref:SamplingPlan ;
    rdfs:range ref:Step ;
    ref:cardinality "0..*" ;
    ref:grounding "ISA" ;
    rdfs:comment "Sampling plan applies at a step" .

ref:perPlan a owl:ObjectProperty ;
    rdfs:label "perPlan" ;
    rdfs:domain ref:MeasurementResult ;
    rdfs:range ref:DataCollectionPlan ;
    ref:cardinality "0..1" ;
    ref:grounding "SEMI" ;
    rdfs:comment "Result collected per DC plan" .

ref:measuredForLot a owl:ObjectProperty ;
    rdfs:label "measuredForLot" ;
    rdfs:domain ref:MeasurementResult ;
    rdfs:range ref:Lot ;
    ref:cardinality "0..1" ;
    ref:grounding "ISA" ;
    rdfs:comment "Material measured" .

ref:measuredForSubstrate a owl:ObjectProperty ;
    rdfs:label "measuredForSubstrate" ;
    rdfs:domain ref:MeasurementResult ;
    rdfs:range ref:Substrate ;
    ref:cardinality "0..1" ;
    ref:grounding "SEMI" ;
    rdfs:comment "Wafer-level metrology (E90/E142) — CD/overlay measured per wafer, not just per lot" .

ref:measuredAtOperation a owl:ObjectProperty ;
    rdfs:label "measuredAtOperation" ;
    rdfs:domain ref:MeasurementResult ;
    rdfs:range ref:RouteOperation ;
    ref:cardinality "0..1" ;
    ref:grounding "ISA + SEMI" ;
    rdfs:comment "Direct route-position link for step-level SPC / yield-by-operation. Kept direct (not only via ProcessStepExecution) because standalone/offline metrology may have no execution to hop through" .

ref:perSamplingPlan a owl:ObjectProperty ;
    rdfs:label "perSamplingPlan" ;
    rdfs:domain ref:MeasurementResult ;
    rdfs:range ref:SamplingPlan ;
    ref:cardinality "0..1" ;
    ref:grounding "ISA + SEMI" ;
    rdfs:comment "Which sampling plan governed this result. NOTE: definitions don't point at one execution — the RESULT records the plan (correct direction). Version-active-at-collection audit is run: scope" .

ref:flaggedOn a owl:ObjectProperty ;
    rdfs:label "flaggedOn" ;
    rdfs:domain ref:SPCViolation ;
    rdfs:range ref:MeasurementResult ;
    ref:cardinality "1" ;
    ref:grounding "ISA" ;
    rdfs:comment "SPC violation on a measurement" .

ref:holds a owl:ObjectProperty ;
    rdfs:label "holds" ;
    rdfs:domain ref:HoldRecord ;
    rdfs:range [ owl:unionOf ( ref:Lot ref:Equipment ref:Carrier ) ] ;
    ref:cardinality "1" ;
    ref:grounding "ISA" ;
    rdfs:comment "Hold freezes a lot, tool or carrier" .

ref:triggeredBy a owl:ObjectProperty ;
    rdfs:label "triggeredBy" ;
    rdfs:domain ref:HoldRecord ;
    rdfs:range ref:SPCViolation ;
    ref:cardinality "0..1" ;
    ref:grounding "ISA" ;
    rdfs:comment "Hold may be triggered by an SPC event" .

ref:raisedFor a owl:ObjectProperty ;
    rdfs:label "raisedFor" ;
    rdfs:domain ref:NonConformanceReport ;
    rdfs:range ref:Lot ;
    ref:cardinality "1" ;
    ref:grounding "ISA" ;
    rdfs:comment "NCR raised for a lot" .

ref:escalatesFrom a owl:ObjectProperty ;
    rdfs:label "escalatesFrom" ;
    rdfs:domain ref:NonConformanceReport ;
    rdfs:range ref:HoldRecord ;
    ref:cardinality "0..1" ;
    ref:grounding "ISA" ;
    rdfs:comment "NCR may escalate from a hold" .

ref:triggersRework a owl:ObjectProperty ;
    rdfs:label "triggersRework" ;
    rdfs:domain [ owl:unionOf ( ref:NonConformanceReport ref:Defect ) ] ;
    rdfs:range ref:ReworkPath ;
    ref:cardinality "0..1" ;
    ref:grounding "ISA" ;
    rdfs:comment "A Rework disposition points to the rework path (the structural link; EXECUTION of the rework is run: scope) Domain widened: dual rework path — via NCR (MRB-gated, default) OR direct from Defect (auto-rework)." .

ref:occursAtOperation a owl:ObjectProperty ;
    rdfs:label "occursAtOperation" ;
    rdfs:domain [ owl:unionOf ( ref:HoldRecord ref:NonConformanceReport ref:Defect ) ] ;
    rdfs:range ref:RouteOperation ;
    ref:cardinality "0..1" ;
    ref:grounding "ISA" ;
    rdfs:comment "Where in the route the quality event occurred — RCA, defect trending, yield-by-operation. Applies to both Hold and NCR (union domain) Domain widened to admit Defect." .

ref:logsEquipment a owl:ObjectProperty ;
    rdfs:label "logsEquipment" ;
    rdfs:domain ref:EquipmentStateLog ;
    rdfs:range ref:Equipment ;
    ref:cardinality "1" ;
    ref:grounding "SEMI" ;
    rdfs:comment "State log records this tool's transitions" .

ref:maintains a owl:ObjectProperty ;
    rdfs:label "maintains" ;
    rdfs:domain ref:MaintenanceWorkOrder ;
    rdfs:range [ owl:unionOf ( ref:Equipment ref:DurableMaterial ) ] ;
    ref:cardinality "1" ;
    ref:grounding "ISA" ;
    rdfs:comment "A7 — generalized from maintainsEquipment: a work order targets equipment OR a durable (reticles/probe cards are cleaned/requalified/reconditioned like equipment)." .

ref:countsFor a owl:ObjectProperty ;
    rdfs:label "countsFor" ;
    rdfs:domain ref:MaintenanceCounter ;
    rdfs:range [ owl:unionOf ( ref:Equipment ref:DurableMaterial ) ] ;
    ref:cardinality "1" ;
    ref:grounding "ISA" ;
    rdfs:comment "A7 — range admits durable floor-life counters as well as equipment counters." .

ref:triggersMaintenance a owl:ObjectProperty ;
    rdfs:label "triggersMaintenance" ;
    rdfs:domain ref:MaintenanceCounter ;
    rdfs:range ref:MaintenanceWorkOrder ;
    ref:cardinality "0..*" ;
    ref:grounding "ISA" ;
    rdfs:comment "Counter threshold triggers a PM work order" .

ref:hasRole a owl:ObjectProperty ;
    rdfs:label "hasRole" ;
    rdfs:domain ref:Person ;
    rdfs:range ref:PersonnelClass ;
    ref:cardinality "0..*" ;
    ref:grounding "ISA" ;
    rdfs:comment "Person belongs to a personnel class / role" .

ref:holdsCertification a owl:ObjectProperty ;
    rdfs:label "holdsCertification" ;
    rdfs:domain ref:Person ;
    rdfs:range ref:Certification ;
    ref:cardinality "0..*" ;
    ref:grounding "ISA" ;
    rdfs:comment "Person holds qualifications" .

ref:requiresCertification a owl:ObjectProperty ;
    rdfs:label "requiresCertification" ;
    rdfs:domain ref:Step ;
    rdfs:range ref:Certification ;
    ref:cardinality "0..*" ;
    ref:grounding "ISA" ;
    rdfs:comment "Step requires a certification (the long-open Step->Certification seam)" .

ref:storedAt a owl:ObjectProperty ;
    rdfs:label "storedAt" ;
    rdfs:domain ref:Lot ;
    rdfs:range ref:StorageLocation ;
    ref:cardinality "0..1" ;
    ref:grounding "ISA" ;
    rdfs:comment "Where the lot currently is (WIP location)" .

ref:carrierStoredAt a owl:ObjectProperty ;
    rdfs:label "carrierStoredAt" ;
    rdfs:domain ref:Carrier ;
    rdfs:range ref:StorageLocation ;
    owl:inverseOf ref:storesCarrier ;
    ref:cardinality "0..1" ;
    ref:grounding "SEMI" ;
    rdfs:comment "Where the carrier is stored (stocker). Inverse storesCarrier: location-first traversal" .

ref:movesLot a owl:ObjectProperty ;
    rdfs:label "movesLot" ;
    rdfs:domain ref:MaterialMovement ;
    rdfs:range ref:Lot ;
    ref:cardinality "0..1" ;
    ref:grounding "ISA" ;
    rdfs:comment "Material moved" .

ref:fromLocation a owl:ObjectProperty ;
    rdfs:label "fromLocation" ;
    rdfs:domain ref:MaterialMovement ;
    rdfs:range ref:StorageLocation ;
    ref:cardinality "0..1" ;
    ref:grounding "ISA" ;
    rdfs:comment "Source location" .

ref:toLocation a owl:ObjectProperty ;
    rdfs:label "toLocation" ;
    rdfs:domain ref:MaterialMovement ;
    rdfs:range ref:StorageLocation ;
    ref:cardinality "0..1" ;
    ref:grounding "ISA" ;
    rdfs:comment "Destination location" .

ref:recordedAt a owl:ObjectProperty ;
    rdfs:label "recordedAt" ;
    rdfs:domain ref:InventoryRecord ;
    rdfs:range ref:StorageLocation ;
    ref:cardinality "1" ;
    ref:grounding "ISA" ;
    rdfs:comment "Location of the stock record" .

ref:operatesOn a owl:ObjectProperty ;
    rdfs:label "operatesOn" ;
    rdfs:domain ref:Capability ;
    rdfs:range ref:DataObject ;
    ref:cardinality "1..*" ;
    ref:grounding "META" ;
    rdfs:comment "Links capability axis to data-object axis" .

ref:specifiesMaterial a owl:ObjectProperty ;
    rdfs:label "specifiesMaterial" ;
    rdfs:domain ref:BOM ;
    rdfs:range ref:Material ;
    ref:cardinality "0..*" ;
    ref:grounding "ISA" ;
    rdfs:comment "BOM lines: which materials, what qty per unit. DEFINITIONAL. Replaces retired bomIncludes." .

ref:segmentRequiresMaterial a owl:ObjectProperty ;
    rdfs:label "segmentRequiresMaterial" ;
    rdfs:domain ref:Step ;
    rdfs:range ref:Material ;
    ref:cardinality "0..*" ;
    ref:grounding "ISA" ;
    rdfs:comment "Per-segment material requirement — the correct home for \"litho step requires reticle + resist\"." .

ref:producesMaterial a owl:ObjectProperty ;
    rdfs:label "producesMaterial" ;
    rdfs:domain ref:Step ;
    rdfs:range ref:Material ;
    ref:cardinality "0..*" ;
    ref:grounding "ISA" ;
    rdfs:comment "Step OUTPUT (produced role) — the other half of genealogy alongside consumption." .

ref:consumesMaterial a owl:ObjectProperty ;
    rdfs:label "consumesMaterial" ;
    rdfs:domain ref:Step ;
    rdfs:range ref:Material ;
    ref:cardinality "0..*" ;
    ref:grounding "ISA" ;
    rdfs:comment "Step consumption (derives from BOM/segment spec). Actual consumed qty per run is run:." .

ref:requiresDurable a owl:ObjectProperty ;
    rdfs:label "requiresDurable" ;
    rdfs:domain ref:Step ;
    rdfs:range ref:DurableMaterial ;
    ref:cardinality "0..*" ;
    ref:grounding "ISA" ;
    rdfs:comment "Structure. Definitional constraint — litho requires a specific reticle." .

ref:loadedInto a owl:ObjectProperty ;
    rdfs:label "loadedInto" ;
    rdfs:domain ref:DurableMaterial ;
    rdfs:range ref:Equipment ;
    ref:cardinality "0..1" ;
    ref:grounding "ISA" ;
    rdfs:comment "Structure. Durable mounted on a tool (reticle in stepper, probe card on prober). WHICH tool now is run: live state." .

ref:maintenanceConsumes a owl:ObjectProperty ;
    rdfs:label "maintenanceConsumes" ;
    rdfs:domain ref:MaintenanceWorkOrder ;
    rdfs:range ref:IndirectMaterial ;
    ref:cardinality "0..*" ;
    ref:grounding "ISA" ;
    rdfs:comment "Structure. Maintenance consumes indirect material (spare parts). SparePart is now a subclass of IndirectMaterial. Replaces retired consumesPart." .

ref:hasFloorLifeCounter a owl:ObjectProperty ;
    rdfs:label "hasFloorLifeCounter" ;
    rdfs:domain ref:DurableMaterial ;
    rdfs:range ref:MaintenanceCounter ;
    ref:cardinality "0..1" ;
    ref:grounding "ISA" ;
    rdfs:comment "Structure. Reuses the MaintenanceCounter pattern. Ticking value/history is run:." .

ref:reservesMaterial a owl:ObjectProperty ;
    rdfs:label "reservesMaterial" ;
    rdfs:domain ref:DispatchDecision ;
    rdfs:range ref:Material ;
    ref:cardinality "0..*" ;
    ref:grounding "—" ;
    rdfs:comment "run:. Dispatch is material-gated (no litho without an available reticle / sufficient resist). Availability evaluation is run:." .

ref:dicedFrom a owl:ObjectProperty ;
    rdfs:label "dicedFrom" ;
    rdfs:domain ref:Die ;
    rdfs:range ref:Substrate ;
    ref:cardinality "1" ;
    ref:grounding "SEMI" ;
    rdfs:comment "Structure. Wafer->die transformation genealogy. Populated (which die from which wafer x,y) is run:." .

ref:assembledFrom a owl:ObjectProperty ;
    rdfs:label "assembledFrom" ;
    rdfs:domain ref:Package ;
    rdfs:range ref:Die ;
    ref:cardinality "0..*" ;
    ref:grounding "—" ;
    rdfs:comment "Derived. KGD-gated die subset of a package (advanced pkg = multi-die). PRIORITY Opcenter comparison axis." .

ref:assembledInto a owl:ObjectProperty ;
    rdfs:label "assembledInto" ;
    rdfs:domain ref:ProductMaterial ;
    rdfs:range ref:ProductMaterial ;
    owl:inverseOf ref:assemblyConstituent ;
    ref:cardinality "0..1" ;
    ref:grounding "—" ;
    rdfs:comment "Derived. Containment die->interposer->package->module. CONTAINED to the assembly subtree; front-end Lot/Substrate keep tree genealogy." .

ref:assemblyConstituent a owl:ObjectProperty ;
    rdfs:label "assemblyConstituent" ;
    rdfs:domain ref:ProductMaterial ;
    rdfs:range ref:ProductMaterial ;
    owl:inverseOf ref:assembledInto ;
    ref:cardinality "0..*" ;
    ref:grounding "—" ;
    rdfs:comment "Derived. Many-parent DAG node — all constituents (dies + interposer + substrate) of a unit." .

ref:mapsWafer a owl:ObjectProperty ;
    rdfs:label "mapsWafer" ;
    rdfs:domain ref:WaferMap ;
    rdfs:range ref:Substrate ;
    owl:inverseOf ref:hasMap ;
    ref:cardinality "1" ;
    ref:grounding "SEMI" ;
    rdfs:comment "Structure. A5 — inverse of the existing hasMap. The wafer this map describes." .

ref:hasDiePosition a owl:ObjectProperty ;
    rdfs:label "hasDiePosition" ;
    rdfs:domain ref:WaferMap ;
    rdfs:range ref:Die ;
    ref:cardinality "0..*" ;
    ref:grounding "SEMI" ;
    rdfs:comment "Structure. Die identity ORIGINATES here (map entry) before dicing. Populated per-die bin/position entries are run:." .

ref:carriesPackage a owl:ObjectProperty ;
    rdfs:label "carriesPackage" ;
    rdfs:domain ref:AssemblyCarrier ;
    rdfs:range ref:Package ;
    ref:cardinality "0..*" ;
    ref:grounding "—" ;
    rdfs:comment "Derived. Strip carries many packages at positions (FOUP-analog). Which package at which position is run:." .

ref:foundOn a owl:ObjectProperty ;
    rdfs:label "foundOn" ;
    rdfs:domain ref:Defect ;
    rdfs:range [ owl:unionOf ( ref:Lot ref:Substrate ref:Die ) ] ;
    ref:cardinality "1" ;
    ref:grounding "ISA + SEMI" ;
    rdfs:comment "The material the defect was found on (lot-level excursion, wafer, or die)." .

ref:hasDefectCode a owl:ObjectProperty ;
    rdfs:label "hasDefectCode" ;
    rdfs:domain ref:Defect ;
    rdfs:range ref:DefectCode ;
    ref:cardinality "0..1" ;
    ref:grounding "SEMI" ;
    rdfs:comment "Defect classification code (ADC/visual catalog)." .

ref:detectedVia a owl:ObjectProperty ;
    rdfs:label "detectedVia" ;
    rdfs:domain ref:Defect ;
    rdfs:range ref:DataCollectionPlan ;
    ref:cardinality "0..1" ;
    ref:grounding "ISA" ;
    rdfs:comment "Inspection/DC plan that surfaced the defect." .

ref:foundOnMap a owl:ObjectProperty ;
    rdfs:label "foundOnMap" ;
    rdfs:domain ref:Defect ;
    rdfs:range ref:WaferMap ;
    ref:cardinality "0..1" ;
    ref:grounding "SEMI" ;
    rdfs:comment "Wafer-map the defect is located on (planar position via the map)." .

ref:escalatesTo a owl:ObjectProperty ;
    rdfs:label "escalatesTo" ;
    rdfs:domain ref:Defect ;
    rdfs:range ref:NonConformanceReport ;
    ref:cardinality "0..1" ;
    ref:grounding "ISA" ;
    rdfs:comment "Defect escalated to an NCR (the MRB-gated rework/disposition path)." .

# ===== AUTO-DECLARED INVERSES (completeness: both directions queryable) =====
ref:partOfLot a owl:ObjectProperty ; rdfs:label "partOfLot" ; owl:inverseOf ref:composedOf ;
    rdfs:domain ref:ProductMaterial ;
    rdfs:range ref:Lot ;
    ref:status "auto-generated inverse" .

ref:containsSubstrate a owl:ObjectProperty ; rdfs:label "containsSubstrate" ; owl:inverseOf ref:locatedInCarrier ;
    rdfs:domain ref:Carrier ;
    rdfs:range ref:Substrate ;
    ref:status "auto-generated inverse" .

ref:hostsCarrier a owl:ObjectProperty ; rdfs:label "hostsCarrier" ; owl:inverseOf ref:dockedAt ;
    rdfs:domain ref:LoadPort ;
    rdfs:range ref:Carrier ;
    ref:status "auto-generated inverse" .

ref:mountedOn a owl:ObjectProperty ; rdfs:label "mountedOn" ; owl:inverseOf ref:hasLoadPort ;
    rdfs:domain ref:LoadPort ;
    rdfs:range ref:Equipment ;
    ref:status "auto-generated inverse" .

ref:partOfSchedule a owl:ObjectProperty ; rdfs:label "partOfSchedule" ; owl:inverseOf ref:includesJobOrder ;
    rdfs:domain ref:JobOrder ;
    rdfs:range ref:WorkSchedule ;
    ref:status "auto-generated inverse" .

ref:partOfControlJob a owl:ObjectProperty ; rdfs:label "partOfControlJob" ; owl:inverseOf ref:manages ;
    rdfs:domain ref:ProcessJob ;
    rdfs:range ref:ControlJob ;
    ref:status "auto-generated inverse" .

ref:storesCarrier a owl:ObjectProperty ; rdfs:label "storesCarrier" ; owl:inverseOf ref:carrierStoredAt ;
    rdfs:domain ref:StorageLocation ;
    rdfs:range ref:Carrier ;
    ref:status "auto-generated inverse" .

# ===== SEAM-STUB CLASSES (undeclared referents — resolve or repoint) =====
ref:ProcessSpecification a owl:Class ; rdfs:label "Process Specification" ; ref:status "Seam stub" ;
    ref:seamNote "Referenced by a domain/range but not yet defined. Resolve (define the object) or repoint on the relevant slice pass." .

# ===== ENUMS (closed) & LOOKUPS (SKOS, extensible) =====
ref:ProcessingType a rdfs:Datatype ;
    rdfs:label "ProcessingType" ;
    ref:grounding "ISA + SEMI" ;
    owl:equivalentClass [ a rdfs:Datatype ; owl:oneOf ( "Logistical" "Metrology" "Process" ) ] .

ref:SubstrateProcessingState a rdfs:Datatype ;
    rdfs:label "SubstrateProcessingState" ;
    ref:grounding "SEMI" ;
    owl:equivalentClass [ a rdfs:Datatype ; owl:oneOf ( "NotProcessed" "InProcess" "Processed" ) ] .

ref:CarrierType a skos:ConceptScheme ; rdfs:label "CarrierType" ;
    ref:grounding "SEMI" ;
    ref:valueKind "lookup (extensible)" .
ref:CarrierType-FOUP a skos:Concept ; skos:inScheme ref:CarrierType ; skos:prefLabel "FOUP" .
ref:CarrierType-Cassette a skos:Concept ; skos:inScheme ref:CarrierType ; skos:prefLabel "Cassette" .
ref:CarrierType-Pod a skos:Concept ; skos:inScheme ref:CarrierType ; skos:prefLabel "Pod" .

ref:CarrierUsage a rdfs:Datatype ;
    rdfs:label "CarrierUsage" ;
    ref:grounding "SEMI" ;
    owl:equivalentClass [ a rdfs:Datatype ; owl:oneOf ( "Test" "Dummy" "Product" "Filler" ) ] .

ref:LotStatus a skos:ConceptScheme ; rdfs:label "LotStatus" ;
    ref:grounding "ISA" ;
    ref:valueKind "lookup (extensible)" .
ref:LotStatus-WIP a skos:Concept ; skos:inScheme ref:LotStatus ; skos:prefLabel "WIP" .
ref:LotStatus-Hold a skos:Concept ; skos:inScheme ref:LotStatus ; skos:prefLabel "Hold" .
ref:LotStatus-Scrap a skos:Concept ; skos:inScheme ref:LotStatus ; skos:prefLabel "Scrap" .

ref:EquipmentElementLevel a rdfs:Datatype ;
    rdfs:label "EquipmentElementLevel" ;
    ref:grounding "ISA" ;
    owl:equivalentClass [ a rdfs:Datatype ; owl:oneOf ( "Enterprise" "Site" "Area" "WorkCenter" "WorkUnit" ) ] .

ref:JobOrderState a skos:ConceptScheme ; rdfs:label "JobOrderState" ;
    ref:grounding "ISA" ;
    ref:valueKind "lookup (extensible)" .
ref:JobOrderState-Scheduled a skos:Concept ; skos:inScheme ref:JobOrderState ; skos:prefLabel "Scheduled" .
ref:JobOrderState-Dispatched a skos:Concept ; skos:inScheme ref:JobOrderState ; skos:prefLabel "Dispatched" .
ref:JobOrderState-Running a skos:Concept ; skos:inScheme ref:JobOrderState ; skos:prefLabel "Running" .
ref:JobOrderState-Completed a skos:Concept ; skos:inScheme ref:JobOrderState ; skos:prefLabel "Completed" .
ref:JobOrderState-Closed a skos:Concept ; skos:inScheme ref:JobOrderState ; skos:prefLabel "Closed" .

ref:OrderState a rdfs:Datatype ;
    rdfs:label "OrderState" ;
    ref:grounding "ISA" ;
    owl:equivalentClass [ a rdfs:Datatype ; owl:oneOf ( "Draft" "Released" "Active" "Complete" "Cancelled" ) ] .

ref:ScheduleState a rdfs:Datatype ;
    rdfs:label "ScheduleState" ;
    ref:grounding "ISA" ;
    owl:equivalentClass [ a rdfs:Datatype ; owl:oneOf ( "Draft" "Published" "Archived" ) ] .

ref:SegmentReqType a rdfs:Datatype ;
    rdfs:label "SegmentReqType" ;
    ref:grounding "ISA" ;
    owl:equivalentClass [ a rdfs:Datatype ; owl:oneOf ( "Equipment" "Material" "Personnel" ) ] .

ref:ResultStatus a rdfs:Datatype ;
    rdfs:label "ResultStatus" ;
    ref:grounding "ISA + SEMI" ;
    owl:equivalentClass [ a rdfs:Datatype ; owl:oneOf ( "Pass" "Fail" "Alarm" ) ] .

ref:HoldState a rdfs:Datatype ;
    rdfs:label "HoldState" ;
    ref:grounding "ISA" ;
    owl:equivalentClass [ a rdfs:Datatype ; owl:oneOf ( "Active" "Released" ) ] .

ref:NCRState a rdfs:Datatype ;
    rdfs:label "NCRState" ;
    ref:grounding "ISA" ;
    owl:equivalentClass [ a rdfs:Datatype ; owl:oneOf ( "Open" "UnderReview" "Approved" "Closed" ) ] .

ref:ProcessJobState a rdfs:Datatype ;
    rdfs:label "ProcessJobState" ;
    ref:grounding "SEMI" ;
    owl:equivalentClass [ a rdfs:Datatype ; owl:oneOf ( "SettingUp" "Waiting" "Processing" "ProcessComplete" "Stopping" "Aborting" "Pausing" "Paused" ) ] .

ref:ControlJobState a rdfs:Datatype ;
    rdfs:label "ControlJobState" ;
    ref:grounding "SEMI" ;
    owl:equivalentClass [ a rdfs:Datatype ; owl:oneOf ( "Queued" "Selected" "Executing" "Paused" "Completed" ) ] .

ref:ExecutionStatus a skos:ConceptScheme ; rdfs:label "ExecutionStatus" ;
    ref:grounding "SEMI" ;
    ref:valueKind "lookup (extensible)" .
ref:ExecutionStatus-InProcess a skos:Concept ; skos:inScheme ref:ExecutionStatus ; skos:prefLabel "InProcess" .
ref:ExecutionStatus-Completed a skos:Concept ; skos:inScheme ref:ExecutionStatus ; skos:prefLabel "Completed" .
ref:ExecutionStatus-Aborted a skos:Concept ; skos:inScheme ref:ExecutionStatus ; skos:prefLabel "Aborted" .

ref:DispositionAction a rdfs:Datatype ;
    rdfs:label "DispositionAction" ;
    ref:grounding "ISA" ;
    owl:equivalentClass [ a rdfs:Datatype ; owl:oneOf ( "Scrap" "Rework" "StripAndReRun" "UseAsIs" "ReturnToSupplier" ) ] .

ref:E10State a rdfs:Datatype ;
    rdfs:label "E10State" ;
    ref:grounding "SEMI" ;
    owl:equivalentClass [ a rdfs:Datatype ; owl:oneOf ( "Productive" "Standby" "Engineering" "ScheduledDown" "UnscheduledDown" "NonScheduled" ) ] .

ref:ControlState a rdfs:Datatype ;
    rdfs:label "ControlState" ;
    ref:grounding "SEMI" ;
    owl:equivalentClass [ a rdfs:Datatype ; owl:oneOf ( "OnlineLocal" "OnlineRemote" "Offline" ) ] .

ref:MaintenanceType a rdfs:Datatype ;
    rdfs:label "MaintenanceType" ;
    ref:grounding "ISA" ;
    owl:equivalentClass [ a rdfs:Datatype ; owl:oneOf ( "Preventive" "Corrective" "Calibration" ) ] .

ref:LocationType a rdfs:Datatype ;
    rdfs:label "LocationType" ;
    ref:grounding "ISA + SEMI" ;
    owl:equivalentClass [ a rdfs:Datatype ; owl:oneOf ( "Stocker" "Buffer" "Shelf" "Bin" ) ] .

ref:BomDirection a rdfs:Datatype ;
    rdfs:label "BomDirection" ;
    ref:grounding "ISA" ;
    owl:equivalentClass [ a rdfs:Datatype ; owl:oneOf ( "Consumed" "Produced" ) ] .

ref:MaterialClass a skos:ConceptScheme ; rdfs:label "MaterialClass" ;
    ref:grounding "ISA" ;
    ref:valueKind "lookup (extensible)" .
ref:MaterialClass-ProductMaterial a skos:Concept ; skos:inScheme ref:MaterialClass ; skos:prefLabel "ProductMaterial" .
ref:MaterialClass-Consumable a skos:Concept ; skos:inScheme ref:MaterialClass ; skos:prefLabel "Consumable" .
ref:MaterialClass-Durable a skos:Concept ; skos:inScheme ref:MaterialClass ; skos:prefLabel "Durable" .
ref:MaterialClass-Indirect a skos:Concept ; skos:inScheme ref:MaterialClass ; skos:prefLabel "Indirect" .

ref:MaterialUse a rdfs:Datatype ;
    rdfs:label "MaterialUse" ;
    ref:grounding "ISA" ;
    owl:equivalentClass [ a rdfs:Datatype ; owl:oneOf ( "Produced" "Consumed" "Sample" ) ] .

ref:QualificationState a rdfs:Datatype ;
    rdfs:label "QualificationState" ;
    ref:grounding "ISA" ;
    owl:equivalentClass [ a rdfs:Datatype ; owl:oneOf ( "Qualified" "Unqualified" "Expired" "KnownGoodDie" "KnownBadDie" ) ] .

ref:TrackingGranularity a rdfs:Datatype ;
    rdfs:label "TrackingGranularity" ;
    ref:grounding "Derived" ;
    owl:equivalentClass [ a rdfs:Datatype ; owl:oneOf ( "LotOfWafers" "WaferMapOfDies" "StripOfPackages" "IndividualUnit" ) ] .

ref:MaterialProvenance a rdfs:Datatype ;
    rdfs:label "MaterialProvenance" ;
    ref:grounding "Derived" ;
    owl:equivalentClass [ a rdfs:Datatype ; owl:oneOf ( "Internal" "ForeignFab" "ExternalSupplier" ) ] .

ref:ManufacturingStage a rdfs:Datatype ;
    rdfs:label "ManufacturingStage" ;
    ref:grounding "—" ;
    owl:equivalentClass [ a rdfs:Datatype ; owl:oneOf ( "FE" "BE" "AP" "FullFlow" "CrossStage" ) ] .

ref:BinType a skos:ConceptScheme ; rdfs:label "BinType" ;
    ref:grounding "SEMI" ;
    ref:valueKind "lookup (extensible)" .
ref:BinType-Electrical a skos:Concept ; skos:inScheme ref:BinType ; skos:prefLabel "Electrical" .
ref:BinType-Functional a skos:Concept ; skos:inScheme ref:BinType ; skos:prefLabel "Functional" .
ref:BinType-Yield a skos:Concept ; skos:inScheme ref:BinType ; skos:prefLabel "Yield" .
ref:BinType-Assembly a skos:Concept ; skos:inScheme ref:BinType ; skos:prefLabel "Assembly" .
ref:BinType-Customer a skos:Concept ; skos:inScheme ref:BinType ; skos:prefLabel "Customer" .

ref:DefectCode a skos:ConceptScheme ; rdfs:label "DefectCode" ;
    ref:grounding "—" ;
    ref:valueKind "lookup (extensible)" .
ref:DefectCode-Particle a skos:Concept ; skos:inScheme ref:DefectCode ; skos:prefLabel "Particle" .
ref:DefectCode-Scratch a skos:Concept ; skos:inScheme ref:DefectCode ; skos:prefLabel "Scratch" .
ref:DefectCode-PatternDefect a skos:Concept ; skos:inScheme ref:DefectCode ; skos:prefLabel "PatternDefect" .
ref:DefectCode-Bridge a skos:Concept ; skos:inScheme ref:DefectCode ; skos:prefLabel "Bridge" .
ref:DefectCode-Void a skos:Concept ; skos:inScheme ref:DefectCode ; skos:prefLabel "Void" .
ref:DefectCode-Contamination a skos:Concept ; skos:inScheme ref:DefectCode ; skos:prefLabel "Contamination" .
ref:DefectCode-Crack a skos:Concept ; skos:inScheme ref:DefectCode ; skos:prefLabel "Crack" .

ref:ReasonCode a skos:ConceptScheme ; rdfs:label "ReasonCode" ;
    ref:grounding "ISA + SEMI" ;
    ref:valueKind "lookup (extensible)" .
ref:ReasonCode-ProcessDeviation a skos:Concept ; skos:inScheme ref:ReasonCode ; skos:prefLabel "ProcessDeviation" .
ref:ReasonCode-EquipmentFault a skos:Concept ; skos:inScheme ref:ReasonCode ; skos:prefLabel "EquipmentFault" .
ref:ReasonCode-OperatorError a skos:Concept ; skos:inScheme ref:ReasonCode ; skos:prefLabel "OperatorError" .
ref:ReasonCode-MaterialIssue a skos:Concept ; skos:inScheme ref:ReasonCode ; skos:prefLabel "MaterialIssue" .
ref:ReasonCode-PlannedActivity a skos:Concept ; skos:inScheme ref:ReasonCode ; skos:prefLabel "PlannedActivity" .
ref:ReasonCode-QualityConcern a skos:Concept ; skos:inScheme ref:ReasonCode ; skos:prefLabel "QualityConcern" .

