    rdfs:range cm:Areaclassification ;
    rdfs:comment "cardinality 1" .

cm:displayOrder a owl:DatatypeProperty ; rdfs:label "Display Order" ; rdfs:domain cm:Area ;
    rdfs:range xsd:integer ;
    rdfs:comment "cardinality 1" .

cm:enableShiftLogbook a owl:DatatypeProperty ; rdfs:label "Enable Shift Logbook" ; rdfs:domain cm:Area ;
    rdfs:range xsd:boolean ;
    rdfs:comment "cardinality 1; conditional on areaClassification = Area (per doc's Additional Information branch)" .

