@prefix cm:   <https://ontology.yourorg.com/mes-cm#> .
@prefix ref:  <https://ontology.yourorg.com/mes-ref#> .
@prefix opc:  <https://ontology.yourorg.com/mes-opc#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<https://ontology.yourorg.com/mes-cm> a owl:Ontology ;
    owl:imports <https://ontology.yourorg.com/mes-ref> ;
    rdfs:comment "Critical Manufacturing (CM) vendor overlay. Deltas only: cm: nodes + SKOS mapping edges to the frozen ref: layer (imported, never restated) and lateral edges to opc:. GENERATED from MES-CM-Overlay-MASTER.xlsx - do not hand-edit." .

# ============================================================
# cm: META-SCHEMA  (declared in cm:, since frozen ref: has no operation axis)
# ============================================================
cm:DataObject a owl:Class ; rdfs:label "CM Data Object" .
cm:ExternalReference a owl:Class ; rdfs:subClassOf cm:DataObject ;
    rdfs:label "CM External Reference (stub for another overlay area or a genuine CM-only concept)" .
cm:Operation a owl:Class ; rdfs:label "CM Operation" .
cm:operatesOn a owl:ObjectProperty ; rdfs:domain cm:Operation ; rdfs:range cm:DataObject ;
    rdfs:label "operatesOn" .
cm:OperationMapping a owl:Class ; rdfs:label "CM Operation Mapping (reified cm->opc correspondence)" .
cm:productSource   a owl:ObjectProperty ; rdfs:domain cm:OperationMapping .
cm:referenceTarget a owl:ObjectProperty ; rdfs:domain cm:OperationMapping .
cm:matchType       a owl:ObjectProperty ; rdfs:domain cm:OperationMapping .
cm:confidence      a owl:DatatypeProperty ; rdfs:domain cm:OperationMapping ; rdfs:range xsd:decimal .
cm:verdict         a owl:AnnotationProperty .
cm:sourceDoc       a owl:AnnotationProperty .
cm:operationKind   a owl:AnnotationProperty .


# ============================================================
# DATA OBJECTS
# ============================================================

cm:Step a owl:Class ; rdfs:subClassOf cm:DataObject ; rdfs:label "Step" ;
    cm:verdict "covered" ;
    cm:sourceDoc "step/, step/create_step" ;
    rdfs:comment "Smallest trackable process operation on Material (WIP). A Service is performed on Material at a Step — resolution via Service Context (optionally Flow/Product/Material-dependent). Reusable across Flows (position identity via Flow Path; intended usage via Logical Names / Logical Flow Paths). Loss/bonus/rework/hold Reasons per Step. Primary/secondary units with Product conversion. ref:Step closeMatch/0.9. Attribute set below sourced from create_step (confirms and supersedes the prior mes-flow-step extract)." .
cm:Step skos:closeMatch ref:Step .

cm:Material a owl:Class ; rdfs:subClassOf cm:DataObject ; rdfs:label "Material" ;
    cm:verdict "covered" ;
    cm:sourceDoc "material/, material/create_material, material/material_page" ;
    rdfs:comment "CM Material is the central WIP-tracking object: any raw material, inventory, WIP (wafer, lot, die, module, PCB), durable, or consumable. Single unified class covering what ref: splits into Lot/Substrate/Die/Package subtypes — CM uses Material Type (lookup) and Form (lookup) attributes to differentiate. ref:ProductMaterial (standardTerm: MaterialLot/Sublot) is the best single mapping target. verdict=covered with note: CM type-flattening vs ref: type hierarchy is the primary structural difference. Material always has Facility, Product, Step, and Flow — these are mandatory associations. POLYMORPHIC COVERAGE: cm:Material is one class spanning what ref: splits into Lot/Substrate/Die/Module/Interposer/PackageSubstrate. CM distinguishes these via customer-defined MaterialForm/MaterialType (both empty on fresh install) + sub-material hierarchy, not separate classes. Mapped as broadMatch to each ref: subtype." .
cm:Material skos:closeMatch ref:ProductMaterial .

cm:Area a owl:Class ; rdfs:subClassOf cm:DataObject ; rdfs:label "Area" ;
    cm:verdict "vendor-extension" ;
    cm:sourceDoc "business-data/area, business-data/area/area_page, business-data/area/create_area" ;
    rdfs:comment "Logical grouping of Steps and Resources, always tied to a Facility; optionally hierarchical (Parent Area / Sub-Areas) and optionally a Production Line or Storage Area (see cm:areaClassification in Enums sheet). No ref: concept exists for Area/Facility partitioning at all (checked across every capability) — verdict stays vendor-extension, now backed by full attribute/property modeling instead of a bare stub. See Object Properties + Attributes sheets for detail; see Candidates for Supply Areas, Transfer Requirement Types, and Shift Logbook (mentioned on-page but not yet source-verified)." .

cm:SortRuleSet a owl:Class ; rdfs:subClassOf cm:DataObject ; rdfs:label "Sort Rule Set" ;
    cm:verdict "vendor-extension" ;
    cm:sourceDoc "sort-rule-set/, sort-rule-set/create_sort_rule_set" ;
    rdfs:comment "Ordered collection of Sort Rules for sorting Materials or Resources for dispatching (Push + Pull). Scope: Material (Get Resource List For Material) or Resource (Get Material List For Resource/Step). Material rules have implicit Hot-Material priority. System rules integrate with released Schedule Scenarios. No ref: dispatch-sorting concept. vendor-extension — dispatch differentiator. Resolves Sort Rule Set stub from Step batch." .

cm:Facility a owl:Class ; rdfs:subClassOf cm:DataObject ; rdfs:label "Facility" ;
    cm:verdict "vendor-extension" ;
    cm:sourceDoc "facility/, facility/create_facility" ;
    rdfs:comment "Physical shop floor location, local or remote (remote = another CM instance). Materials, Containers, Resources are Facility-assigned; Materials cross Facilities only via Ship Material. Part of the ISA-95 hierarchy (Enterprise > Site > Facility > Area) which is entirely absent from ref: (see Candidates). vendor-extension. Resolves Facility stub from Area batch." .

cm:Calendar a owl:Class ; rdfs:subClassOf cm:DataObject ; rdfs:label "Calendar" ;
    cm:verdict "vendor-extension" ;
    cm:sourceDoc "calendar/, calendar/create_calendar, calendar/generate_calendar_days" ;
    rdfs:comment "Company fiscal/reporting calendar mapping civil days/times to operational + reporting structures. Defines year start, day start time, default shift per weekday, timezone. Associated to a set of Calendar Days. Facility has default Calendar; each Area has its own; Employee and Team associate to a Calendar. No ref: concept for fiscal/reporting calendars. vendor-extension. (Resolves the Calendar stub introduced in the Area batch.)" .

cm:Schedule a owl:Class ; rdfs:subClassOf cm:DataObject ; rdfs:label "Schedule" ;
    cm:verdict "partial" ;
    cm:sourceDoc "schedule/, schedule/create_schedule" ;
    rdfs:comment "Optimizes Resource processing sequences for one or more Areas — two-step engine (deterministic + optional time-bound solver) with optimization criteria, frozen period, feed steps. Resources use either Dispatching OR Scheduling. Scheduling licensed module. ref:WorkSchedule relatedMatch/0.55 — ref:WorkSchedule is an operations schedule concept; CM Schedule is the optimizer/engine object. Resolves Schedule stub from Calendar batch (was partial 0.4 as placeholder)." .
cm:Schedule skos:relatedMatch ref:WorkSchedule .

cm:Employee a owl:Class ; rdfs:subClassOf cm:DataObject ; rdfs:label "Employee" ;
    cm:verdict "covered" ;
    cm:sourceDoc "employee/, employee/create_employee" ;
    rdfs:comment "Business object representing functionality associated with a system User. Has Qualifications, Certifications; associated with Calendar, optionally Team and Area; can have a Manager; assigned to Maintenance Activity Orders. ref:Person (Grounded, operator/technician/engineer). closeMatch/0.75 - CM Employee is always tied to a User (broader identity binding than ref:Person). Resolves Employee stub from Area batch (was partial 0.4, now confirmed via source)." .
cm:Employee skos:closeMatch ref:Person .

cm:Resource a owl:Class ; rdfs:subClassOf cm:DataObject ; rdfs:label "Resource" ;
    cm:verdict "covered" ;
    cm:sourceDoc "resource/, resource/create_resource, resource/resource_page" ;
    rdfs:comment "CM Resource = any scarce entity participating in processing or storage of Material (equipment, stocker, instrument, transport, consumable feed, load port, line). ref:Equipment (ISA+SEMI, E30, Grounded) = logical production tool. closeMatch/0.75: CM Resource is broader — covers what ref: splits into Equipment (process/instrument) and ref:StorageLocation (storage). ProcessingType attribute is CM's mechanism for this differentiation. Resource always belongs to an Area. NOTE: Resource ProcessingType (Component/Consumable Feed/Instrument/Line/Load Port/Process/Storage/Transport) means cm:Resource covers ref:Equipment (Process), ref:LoadPort (Load Port), and ref:StorageLocation (Storage) as one polymorphic class rather than separate subtypes." .
cm:Resource skos:closeMatch ref:Equipment .

cm:Notification a owl:Class ; rdfs:subClassOf cm:DataObject ; rdfs:label "Notification" ;
    cm:verdict "vendor-extension" ;
    cm:sourceDoc "notification/, notification/create_notification" ;
    rdfs:comment "Asynchronous alarm with user-defined severity, targeting Employee/Role/Everyone. Clearance types: ManualSingleUser/ManualEveryUser/Automatic (Valid To). Visibility filtered by Facility/Area/Resource/Step, matched against Workgroup. Pub/sub to GUI. Licensed module. No ref: concept. vendor-extension. Resolves Notification stub referenced across many objects." .

cm:Batch a owl:Class ; rdfs:subClassOf cm:DataObject ; rdfs:label "Batch" ;
    cm:verdict "vendor-extension" ;
    cm:sourceDoc "batch/, batch/batch_page, batch/create_batch" ;
    rdfs:comment "Groups Materials loaded/processed/unloaded together on a Batch-Scheduling-Type Resource. No ref: concept for equipment-capacity material grouping (checked: no Batch/ProcessBatch/MaterialBatch IRI anywhere). ref:ProcessJob (E40, 'Process executed on a subset of substrates using a recipe') is conceptually adjacent but a different shape — CM's own docs say creating a Batch auto-creates a cm:ResourceJob, suggesting ResourceJob (not Batch) is the closer E40 analog. Not asserted as a match here — see Candidates. Batch has a documented multi-state lifecycle (Loading State / System State / Batch Material Lifecycle) — out of scope for this definitional layer per project rules (state machines belong to run:); logged to Candidates for whoever builds that layer." .

cm:BatchMaterial a owl:Class ; rdfs:subClassOf cm:DataObject ; rdfs:label "Batch Material" ;
    cm:verdict "vendor-extension" ;
    cm:sourceDoc "batch/create_batch, batch/manage_batch_materials (title only)" ;
    rdfs:comment "Association entity linking a Batch to one of its Materials — not a plain relation: it carries its own attribute (isMainMaterial) and its own documented lifecycle (Not Loaded/Loaded/In Process/Processed/Unloaded), so modeled as a first-class object rather than folded into a bare object property. Contrast with Batch-Container, which the source docs show as a plain add/remove membership with no extra attributes — kept as a simple object property instead of a second association entity, deliberately not over-modeled to match Batch Material's shape." .

cm:Container a owl:Class ; rdfs:subClassOf cm:DataObject ; rdfs:label "Container" ;
    cm:verdict "covered" ;
    cm:sourceDoc "container/, container/create_container" ;
    rdfs:comment "CM Container is a SUPERSET of ref:Carrier (SEMI E87 FOUP/Cassette/Pod). Container with PositionUnitType=Material holding wafers IS a carrier — CM fully covers the carrier capability. broadMatch/0.7 because CM Container is strictly broader (adds nesting, Resource/Container position types, capacity validation, orientation) — not a 1:1 equivalence. Verdict changed from vendor-extension to covered: CM does what ref:Carrier requires, plus more. Holds Material/Container/Resource at positions. Capacity per position in units. Hierarchical (sub-Containers). Can associate to a Resource. ref: has NO Container concept (only ref:Carrier, the SEMI FOUP/cassette narrow slice). CM Container is far broader (multi-type positional vessel with capacity validation, orientation, nesting) — verdict stays vendor-extension per the reviewer decision. Resolves the Container stub from Batch/Material batches. State model (Available/Unavailable/In Transit) -> run:." .
cm:Container skos:broadMatch ref:Carrier .

cm:ResourceJob a owl:Class ; rdfs:subClassOf cm:DataObject ; rdfs:label "Resource Job" ;
    cm:verdict "partial" ;
    cm:sourceDoc "resource-job/, resource-job/create_resource_job" ;
    rdfs:comment "Generic object managing a list of Materials and Containers involved in a job on a Resource. Three embedded entities: Resource Job (Type/Priority/Progress/Equipment Job Id), Resource Job Material (embedded, not separately editable), Resource Job Container (embedded). Selection mode Step/Flow Path/Flow Logical Path. Lifecycle Created->Queued->Executing->Completed (+Abort/Cancel) -> run:. CONFIRMS reviewer decision: maps to ref:ControlJob (E94 carrier processing sequence at a tool), not ref:ProcessJob (E40 recipe on substrates) — embedded Material/Container membership matches ControlJob shape. relatedMatch/0.55 (CM inlines membership vs separate entity model)." .
cm:ResourceJob skos:relatedMatch ref:ControlJob .

cm:TransferRequirement a owl:Class ; rdfs:subClassOf cm:DataObject ; rdfs:label "Transfer Requirement" ;
    cm:verdict "vendor-extension" ;
    cm:sourceDoc "transfer-requirement/, transfer-requirement/create_transfer_requirement" ;
    rdfs:comment "Quantity demands for Products required by a storage/production system: products + quantities (duplicates allowed) to transfer between Storage Areas or to a Resource. Request Type comes from the Area (Manage Transfer Requirement Types — confirms the Area-batch reviewer finding). Source/Destination auto-derived from the Transfer Requirement Type. Lifecycle Requested->Approved->Released->Picked->In Transport->Delivered->Closed (+Cancel/Unapprove) -> run:. Fulfilled via Pick Lists and Transfer Orders. vendor-extension. PROMOTES the External Reference added in the reviewer round to a full Data Object." .

cm:BinConverter a owl:Class ; rdfs:subClassOf cm:DataObject ; rdfs:label "Bin Converter" ;
    cm:verdict "vendor-extension" ;
    cm:sourceDoc "bin-converter/, bin-converter/bin_converter_page, bin-converter/create_bin_converter" ;
    rdfs:comment "A set of bin code conversions applied to a Substrate Map for visual/value remapping of die bin codes. Semiconductor-specific (SEMI E142 bin codes). No ref: concept exists for a bin-code conversion layer — ref:WaferMap (E142) is the closest parent concept but models the map itself, not a conversion rule applied to it. vendor-extension." .

cm:BinConversion a owl:Class ; rdfs:subClassOf cm:DataObject ; rdfs:label "Bin Conversion" ;
    cm:verdict "vendor-extension" ;
    cm:sourceDoc "bin-converter/create_bin_converter" ;
    rdfs:comment "First-class association entity (NOT a plain relationship) — carries 7–14 attributes depending on BinConverterType (Colors vs Colors and Values). Has its own 'Default' flag with a uniqueness constraint (at most one per BinConverter may be Default=true — SHACL CANDIDATE). See Attributes sheet." .

cm:SubstrateMap a owl:Class ; rdfs:subClassOf cm:DataObject ; rdfs:label "Substrate Map" ;
    cm:verdict "covered" ;
    cm:sourceDoc "substrate-map/, substrate-map/create_substrate_map, substrate-map/cm_semi_e142_schema" ;
    rdfs:comment "Map of a substrate (wafer/frame/strip/tray/panel) in SEMI E142 format (XML + Unit Level). Map types: BinCodeMap, DeviceIdMap, TransferMap, DeviceDataMap. Coordinate system: Axis Direction (Up Right default), Origin Location (Lower Left default), Orientation (0/90/180/270). Overlays over a base map; Overlay Information management; device bin-code history + device genealogy views. Mapping licensed module. ref:WaferMap (E142, standardTerm=SubstrateMap) closeMatch/0.85 — the ref: concept was authored for exactly this. Stub promoted (was set in Bin Converter batch)." .
cm:SubstrateMap skos:closeMatch ref:WaferMap .

cm:MaterialHold a owl:Class ; rdfs:subClassOf cm:DataObject ; rdfs:label "Material Hold" ;
    cm:verdict "covered" ;
    cm:sourceDoc "material/hold_material, material/material_page" ;
    rdfs:comment "CM MaterialHold IS a hold record — Material placed on Hold with state/Reason/comment, persists until released. ref:HoldRecord = 'Freezes a lot/tool/carrier from further processing on an anomaly.' CM fully covers the material-hold case and extends it (concurrent holds per Reason, security Role for release). broadMatch/0.7 because ref: also covers tool/carrier holds which CM models differently (Resource state changes, not MaterialHold). Verdict changed from vendor-extension to covered." .
cm:MaterialHold skos:broadMatch ref:HoldRecord .

cm:MaterialTimeConstraint a owl:Class ; rdfs:subClassOf cm:DataObject ; rdfs:label "Material Time Constraint" ;
    cm:verdict "partial" ;
    cm:sourceDoc "material/manage_material_time_constraints" ;
    rdfs:comment "Instance-level time constraint on a specific Material tracking between two Steps (From Step/Op, To Step/Op, Type min/max, Time Limit Date, Warning Date). DISTINCT from ref:TimeConstraint which is a route-definition-level constraint (not material-instance-level). relatedMatch/0.5 — same conceptual domain (Q-time), different modeling level (instance vs definition)." .
cm:MaterialTimeConstraint skos:relatedMatch ref:TimeConstraint .

cm:MaterialReworkPath a owl:Class ; rdfs:subClassOf cm:DataObject ; rdfs:label "Material Rework Path" ;
    cm:verdict "vendor-extension" ;
    cm:sourceDoc "material/material_page (Holds/Off-Flows/Reworks section)" ;
    rdfs:comment "Instance-level rework path record on a Material — distinct from cm:ReworkPath (the route-definition-level path configuration). Tracks an active rework of a specific Material." .

cm:Flow a owl:Class ; rdfs:subClassOf cm:DataObject ; rdfs:label "Flow" ;
    cm:verdict "covered" ;
    cm:sourceDoc "flow/, flow/create_flow" ;
    rdfs:comment "Pre-defined route/path for Material, composed of Flow Items (each a Step OR a nested Flow). Material is always in a Flow (TopMost when nested). Unique position via Flow Path (Flow:Revision:CorrelationId/.../Step:CorrelationId) — CorrelationId preserves compatibility across versions and maps to Position. Change-set versioned. Structure types: Sequential / Alternate (Single or Multiple Selection) / Non-Sequential Block / Line — Non-Sequential Block and Line may contain only Steps. ref:Route closeMatch/0.9. SUPERSEDES the prior mes-flow-step extract (which modeled only booleans isAlternate/isNonSequentialBlock — the real model is a 4-value structure enum + selection mode). Flow nesting remains a vendor-extension finding: ref:RouteOperation.realizes is cardinality-1 to a Step, no recursion (Candidates #1)." .
cm:Flow skos:closeMatch ref:Route .

cm:ProductionOrder a owl:Class ; rdfs:subClassOf cm:DataObject ; rdfs:label "Production Order" ;
    cm:verdict "covered" ;
    cm:sourceDoc "production-order/, production-order/create_production_order" ;
    rdfs:comment "A demand materialized through one or several Materials. Order Management licensed module. Tracks Production Order Materials + quantities + state (In Progress/Completed/Delivered). Completion when Material reaches a Marks-Product-Completion Step (matching Product+Units); Delivered when shipped to a terminate-on-ship Facility. Can be restricted (no material add/remove). Owner Role. Has PO Steps + step dependencies. ref:ProductionRequest (request to produce a product — the order) closeMatch/0.8. Resolves Production Order stub from Material batch." .
cm:ProductionOrder skos:closeMatch ref:ProductionRequest .

cm:DataCollectionInstance a owl:Class ; rdfs:subClassOf cm:ExternalReference ; rdfs:label "Data Collection Instance" ;
    cm:verdict "vendor-extension" ;
    cm:sourceDoc "material/material_page (Collected Data section)" ;
    rdfs:comment "Runtime instance of a Data Collection associated with a Material. Full modeling deferred to the Data Collection batch." .

cm:ProtocolMaterial a owl:Class ; rdfs:subClassOf cm:DataObject ; rdfs:label "Protocol Material" ;
    cm:verdict "vendor-extension" ;
    cm:sourceDoc "protocol/ (association)" ;
    rdfs:comment "Association: a Material associated with a Protocol Instance. (Promoted from stub introduced in Material batch.) Carries per-instance Inhibit Ship / Inhibit Move From Step behavior." .

cm:MaterialTransferMaterial a owl:Class ; rdfs:subClassOf cm:DataObject ; rdfs:label "Material Transfer Material" ;
    cm:verdict "vendor-extension" ;
    cm:sourceDoc "material-transfer/ (association)" ;
    rdfs:comment "Association entity: a Material line within a Material Transfer request. (Promoted from the stub introduced in the Material batch.)" .

cm:FutureAction a owl:Class ; rdfs:subClassOf cm:ExternalReference ; rdfs:label "Future Action" ;
    cm:verdict "vendor-extension" ;
    cm:sourceDoc "material/, material/manage_material_future_actions" ;
    rdfs:comment "A planned operation to be performed on a Material at a future Step. No ref: concept for future action queuing. Appears across multiple CM objects (also Step). Full modeling deferred." .

cm:Product a owl:Class ; rdfs:subClassOf cm:DataObject ; rdfs:label "Product" ;
    cm:verdict "covered" ;
    cm:sourceDoc "product/, product/create_product" ;
    rdfs:comment "Set of desired Material characteristics; every Material has one Product. Defines default start Flow Path (Flow/Step/position). Enable/disable + block. Unit conversion factors (bidirectional, e.g. Wafers<->Dies). Refers to a Product Group (inherits + overrides parameters). Change-set versioned + global data. Rich: binning tree, sub-products tree, characteristics, costs, rules, maintenance, logistics, planning, scheduling, safety. ref:Product (specific sourced device type) closeMatch/0.85. Resolves Product stub referenced across many objects." .
cm:Product skos:closeMatch ref:Product .

cm:ResourceService a owl:Class ; rdfs:subClassOf cm:DataObject ; rdfs:label "Resource Service" ;
    cm:verdict "vendor-extension" ;
    cm:sourceDoc "resource/ (Tying Everything Together), resource/manage_resource_services" ;
    rdfs:comment "Association entity linking a Resource to a Service it provides, optionally with Personnel Requirements (Certification). Not a plain relationship — carries its own attributes (Personnel Requirements). Full modeling deferred." .

cm:StorageBin a owl:Class ; rdfs:subClassOf cm:DataObject ; rdfs:label "Storage Bin" ;
    cm:verdict "partial" ;
    cm:sourceDoc "resource/create_resource (Step 3: Storage Bins), resource/manage_resource_storage_bins" ;
    rdfs:comment "A named sub-division of a Storage Resource, restricted to specific Container Type or Material/Product/CapacityClass. ref:StorageLocation (E88, Grounded) = 'stocker/buffer/shelf/bin'. narrowMatch because CM StorageBin is a position within a Resource rather than an independently-addressed location." .
cm:StorageBin skos:narrowMatch ref:StorageLocation .

cm:ResourceLane a owl:Class ; rdfs:subClassOf cm:DataObject ; rdfs:label "Resource Lane" ;
    cm:verdict "vendor-extension" ;
    cm:sourceDoc "resource/create_resource (Step 3: Lanes), resource/manage_resource_lanes" ;
    rdfs:comment "A named processing lane within a multilane Resource (e.g. a multi-track diffusion furnace). Each Lane can have its own Recipe when PerLane recipe mode is active. No ref: concept for intra-resource lane partitioning." .

cm:ResourceLocation a owl:Class ; rdfs:subClassOf cm:DataObject ; rdfs:label "Resource Location" ;
    cm:verdict "vendor-extension" ;
    cm:sourceDoc "resource/create_resource (Step 3: Locations), resource/manage_resource_locations" ;
    rdfs:comment "A named position within a Consumable Feed or Process Resource, with X/Y coordinates and position count. Used for consumable feed tracking. No ref: equivalent." .

cm:SetupMatrix a owl:Class ; rdfs:subClassOf cm:DataObject ; rdfs:label "Setup Matrix" ;
    cm:verdict "vendor-extension" ;
    cm:sourceDoc "setup-matrix/, setup-matrix/create_setup_matrix" ;
    rdfs:comment "Changeover-time matrix relating Services (From Service x To Service -> time) for Scheduling. Shareable across Resources. Time scale Seconds/Minutes/Hours/Days; Use Zero In Diagonal option. No ref: changeover/setup-matrix concept. vendor-extension. Resolves Setup Matrix stub from Resource batch." .

cm:BOM a owl:Class ; rdfs:subClassOf cm:DataObject ; rdfs:label "BOM" ;
    cm:verdict "covered" ;
    cm:sourceDoc "bom/, bom/create_bom, bom/bom_page, bom/manage_bomitems" ;
    rdfs:comment "Source Products + quantities to assemble one unit of a target Product at a Step, OR parts for a Maintenance Activity. ref:BOM (\"Materials consumed/produced by the route\") is a clean match. closeMatch/0.85: CM BOM is change-set-versioned with multiple scopes (Materials/Durables/Packing/Parts/Weigh-And-Dispense/Compose Map) — richer than the ref: definitional node. Change-controlled: Target Product is global, everything else versioned." .
cm:BOM skos:closeMatch ref:BOM .

cm:Recipe a owl:Class ; rdfs:subClassOf cm:DataObject ; rdfs:label "Recipe" ;
    cm:verdict "covered" ;
    cm:sourceDoc "recipe/, recipe/create_recipe" ;
    rdfs:comment "Equipment information for processing a Material at a Step. Static/dynamic parameters + optional body (binary/text). Sub-Recipes for modularity/reuse. Resolved via Recipe Context. Global data: Is Enabled, Is Executable; everything else versioned (change-set). Recipe Management licensed module. Upload to Resource (SEMI GEM download). ref:Recipe closeMatch/0.85. Resolves Recipe stub from Resource/Qualification Check batches." .
cm:Recipe skos:closeMatch ref:Recipe .

cm:MaintenancePlan a owl:Class ; rdfs:subClassOf cm:DataObject ; rdfs:label "Maintenance Plan" ;
    cm:verdict "vendor-extension" ;
    cm:sourceDoc "maintenance-plan/, maintenance-plan/create_maintenance_plan" ;
    rdfs:comment "Core of Maintenance Management (licensed module). Reusable, change-set versioned plan of Maintenance Activities (Time/Usage/Time and Usage/Ad-hoc triggers). Associated to Areas/Materials/Resources/Containers via Maintenance Plan Instance (MPI) — extensible to other entities via custom Features. No single ref: maintenance-plan concept (ref: has MaintenanceWorkOrder for the order itself and MaintenanceCounter, but no plan/schedule definition object). vendor-extension. Resolves Maintenance Plan stub from Resource batch." .

cm:Certification a owl:Class ; rdfs:subClassOf cm:DataObject ; rdfs:label "Certification" ;
    cm:verdict "covered" ;
    cm:sourceDoc "certification/, certification/create_certification" ;
    rdfs:comment "Represents a skill set assignable to Employees. Employee is certified only when explicitly granted OR by meeting required Qualifications at defined proficiency. Required by Resource (personnel requirements) and Step (execution requirement). ref:Certification exists (Grounded). closeMatch/0.85. Resolves the Certification stub from Resource batch. Has a state model (Assigned/Active/Expired/Grace/In Progress) per Employee - run: layer." .
cm:Certification skos:closeMatch ref:Certification .

cm:BOMProduct a owl:Class ; rdfs:subClassOf cm:DataObject ; rdfs:label "BOM Product" ;
    cm:verdict "vendor-extension" ;
    cm:sourceDoc "bom/manage_bomitems" ;
    rdfs:comment "A line item in a BOM — a source Product with quantity, plus substitute Products. First-class association entity (carries Quantity, Fixed Quantity, Bin Code, substitute chain). Negative Quantity indicates a by-product/co-product (no substitutes allowed then). No ref: concept for BOM line items." .

cm:BusinessPartner a owl:Class ; rdfs:subClassOf cm:DataObject ; rdfs:label "Business Partner" ;
    cm:verdict "vendor-extension" ;
    cm:sourceDoc "business-partner/, business-partner/create_business_partner" ;
    rdfs:comment "Simple object referenced by a Production Order; can hold roles Contractor/Customer/Supplier/Manufacturer (non-exclusive). Explicitly NOT a full CRM/ERP customer system. No ref: concept for business partners (out of MES core scope). vendor-extension." .

cm:CalendarDay a owl:Class ; rdfs:subClassOf cm:DataObject ; rdfs:label "Calendar Day" ;
    cm:verdict "vendor-extension" ;
    cm:sourceDoc "calendar/, calendar/generate_calendar_days, calendar/edit_calendardays" ;
    rdfs:comment "Specific instantiation of a day in a Calendar. Defines the Shift Definition for that day and the Team working each Shift Definition Shift (via Calendar Day Shift Definition Shift sub-entity). Working/non-working. First-class entity generated in bulk via Generate Calendar Days." .

cm:ShiftDefinition a owl:Class ; rdfs:subClassOf cm:DataObject ; rdfs:label "Shift Definition" ;
    cm:verdict "vendor-extension" ;
    cm:sourceDoc "shift-definition/, shift-definition/create_shift_definition" ;
    rdfs:comment "A 24h shift arrangement: multiple Shifts + non-working periods within Shifts. Default for weekdays of a Calendar; each Calendar Day can have its own; Teams assigned per Shift per Calendar Day. Must have same start time as Calendar Day. No ref: shift concept. vendor-extension. Resolves Shift Definition stub from Calendar batch." .

cm:Team a owl:Class ; rdfs:subClassOf cm:DataObject ; rdfs:label "Team" ;
    cm:verdict "vendor-extension" ;
    cm:sourceDoc "team/, team/create_team" ;
    rdfs:comment "A set of Employees assigned together to a Shift on a Calendar Day. Always associated with a Calendar. Team Code used in Shift Patterns / Shift Planning display. No ref: team concept (ref:PersonnelClass is a classification, not a working group). vendor-extension. Resolves Team stub from Calendar batch." .

cm:ShiftPlan a owl:Class ; rdfs:subClassOf cm:DataObject ; rdfs:label "Shift Plan" ;
    cm:verdict "vendor-extension" ;
    cm:sourceDoc "shift-plan/, shift-plan/create_shift_plan" ;
    rdfs:comment "Organizes Resources + Employees into Workgroups; schedules each Employee to Workgroup+Position per Calendar Day. Shortage/excess checks, working-hour rule validation (ShiftPlanning-scope rules), temporary assignments, availability pool, per-Employee work calendar view. Labor Management licensed module. No ref: labor-planning concept. vendor-extension. Resolves Shift Plan stub from Calendar batch." .

cm:Role a owl:Class ; rdfs:subClassOf cm:ExternalReference ; rdfs:label "Role" ;
    cm:verdict "vendor-extension" ;
    cm:sourceDoc "(referenced)" ;
    rdfs:comment "Stub referenced by Certification. Full modeling deferred to Role batch." .

cm:Qualification a owl:Class ; rdfs:subClassOf cm:DataObject ; rdfs:label "Qualification" ;
    cm:verdict "partial" ;
    cm:sourceDoc "qualification/, qualification/create_qualification" ;
    rdfs:comment "A particular SKILL acquired by an Employee (training/education). Assignable to multiple Employees at different proficiency levels. Meeting all Qualifications required by a Certification auto-grants that Certification. Lifecycle Active/Grace Period/Expired. ref: has no personnel-skill concept; ref:PersonnelClass (classification of personnel/role) is adjacent (relatedMatch/0.45 — skill vs role classification). Resolves Qualification stub from Certification/Employee batches. NOTE: distinct from Qualification Check (equipment qualification)." .
cm:Qualification skos:relatedMatch ref:PersonnelClass .

cm:ChangeSet a owl:Class ; rdfs:subClassOf cm:DataObject ; rdfs:label "Change Set" ;
    cm:verdict "vendor-extension" ;
    cm:sourceDoc "change-set/, change-set/create_change_set" ;
    rdfs:comment "Bundles changes to versioned objects (only versioned data, not global). 20+ change-controlled object types (BOM, Product, Recipe, Flow, Checklist, etc.). Approval via Role or Workflow. Cross-cutting CM versioning mechanism. No ref: concept — ref: has no change-control/versioning model (definitional layer only). vendor-extension. Resolves the versioning candidate from BOM batch." .

cm:ChangeSetItem a owl:Class ; rdfs:subClassOf cm:DataObject ; rdfs:label "Change Set Item" ;
    cm:verdict "vendor-extension" ;
    cm:sourceDoc "change-set/manage_change_set_items" ;
    rdfs:comment "A single versioned-object-version within a Change Set, with its own individual approval Role and approval state. A version can belong to only one Change Set; no two versions of the same object in one Change Set." .

cm:Workflow a owl:Class ; rdfs:subClassOf cm:DataObject ; rdfs:label "Workflow" ;
    cm:verdict "vendor-extension" ;
    cm:sourceDoc "CROSS-REFERENCED: change-set/ (approval workflow states + reviewers), CM product docs (user-defined approval workflows, reviewers per step, enforced by object and type). Dedicated business-data/workflow/ page NOT in scrape and not retrievable via search." ;
    rdfs:comment "User-defined APPROVAL workflow entity: a sequence of states, each with reviewer Roles and reviewer types (Approver / Notified); enforced per object and type; drives Change Set approval cycles with email notifications and electronic signatures for regulatory compliance. DISTINCT from Low Code Business Workflows (DEE drag-drop automation) and Automation Controller workflows (Connect IoT) — those are different subsystems. NEEDS VERIFICATION: attributes/operations below are inferred from corroborated references, not the dedicated page. No ref: approval-workflow concept. vendor-extension." .

cm:Chart a owl:Class ; rdfs:subClassOf cm:DataObject ; rdfs:label "Chart" ;
    cm:verdict "vendor-extension" ;
    cm:sourceDoc "chart/, chart/create_chart" ;
    rdfs:comment "Statistical Process Control (SPC) Chart (licensed module). Has a Chart Type, associated with a numeric Parameter, plus SPC Rules for violation detection that can auto-open a Protocol Instance. Context-reusable via Chart Context Information (keys). No ref: SPC/Chart concept — ref: has MeasurementResult (parametric values) but no chart/control-limit model. vendor-extension. Strong CM-vs-Opcenter differentiator (built-in SPC with Nelson/Western Electric rules)." .

cm:LogicalChart a owl:Class ; rdfs:subClassOf cm:DataObject ; rdfs:label "Logical Chart" ;
    cm:verdict "vendor-extension" ;
    cm:sourceDoc "chart/" ;
    rdfs:comment "A unique combination of Chart keys within a Chart (context instance). Holds Data Points." .

cm:DataPoint a owl:Class ; rdfs:subClassOf cm:DataObject ; rdfs:label "Data Point" ;
    cm:verdict "vendor-extension" ;
    cm:sourceDoc "chart/" ;
    rdfs:comment "A sample of data (may contain many readings), associated with a Chart and a Logical Chart. Has Data Point Context, Data Point Reading, Data Point Violation sub-structures." .

cm:ChartRule a owl:Class ; rdfs:subClassOf cm:DataObject ; rdfs:label "Chart Rule" ;
    cm:verdict "vendor-extension" ;
    cm:sourceDoc "chart/manage_chart_rules" ;
    rdfs:comment "A rule applied to a Chart to detect violations (SPC Rule or SPC Action Rule). Pre-configured set: Nelson 1-8, Western Electric 1-4, Out of Spec. Extensible. Violation can auto-open a Protocol." .

cm:Parameter a owl:Class ; rdfs:subClassOf cm:DataObject ; rdfs:label "Parameter" ;
    cm:verdict "vendor-extension" ;
    cm:sourceDoc "parameter/, parameter/create_parameter" ;
    rdfs:comment "Reusable definition object underpinning Data Collection, KPI, SPC/Chart, Recipe, Product, Product Group. Abstracts Resource-specific variable names to a common MES/human-level meaning. Scopes: EDC/SPC/Recipe Management/KPI Management (and combinations). Data types: Boolean/DateTime/Decimal/Duration/Long/String/URL. No single ref: parameter-definition object (ref: has MeasurementResult for values, not the reusable definition). vendor-extension. Resolves Parameter stub referenced by Chart, Data Collection, KPI." .

cm:Checklist a owl:Class ; rdfs:subClassOf cm:DataObject ; rdfs:label "Checklist" ;
    cm:verdict "vendor-extension" ;
    cm:sourceDoc "checklist/, checklist/create_checklist" ;
    rdfs:comment "A procedure = sequence of Checklist Items to perform in a situation (e.g. maintenance checklist). A template/definition from which Checklist Instances are created. Change-controlled (versioned). Scopes: Exception Management/General/Maintenance/Material Tracking/Resource Tracking. Execution Immediate or Long Running. No ref: checklist concept. vendor-extension." .

cm:ChecklistItem a owl:Class ; rdfs:subClassOf cm:DataObject ; rdfs:label "Checklist Item" ;
    cm:verdict "vendor-extension" ;
    cm:sourceDoc "checklist/" ;
    rdfs:comment "An item in a Checklist. Type: Manual Task / Manual Action (DEE) / Automatic Action (DEE) / Signature. Sequential or Floating. Optional or Mandatory (Automatic Actions cannot be Floating/Optional)." .

cm:ChecklistInstance a owl:Class ; rdfs:subClassOf cm:DataObject ; rdfs:label "Checklist Instance" ;
    cm:verdict "vendor-extension" ;
    cm:sourceDoc "checklist/" ;
    rdfs:comment "An active runtime object created from a Checklist definition, with independent lifetime. Has its own state (Open/Pause/Resume/Perform/Terminate) — run: layer." .

cm:DataCollection a owl:Class ; rdfs:subClassOf cm:DataObject ; rdfs:label "Data Collection" ;
    cm:verdict "covered" ;
    cm:sourceDoc "data-collection/, data-collection/create_data_collection" ;
    rdfs:comment "A plan to collect quantitative/qualitative data at ad-hoc or specific processing points. Set of qualified Parameters (sample material form, sample count, readings, mandatory, calculation, limit checking). Creates Data Collection Instances (Immediate/Immediate Ad-hoc/Long Running). Integrates with SPC. ref:DataCollectionPlan is a clean match. closeMatch/0.8. Change-set versioned. Resolves the Data Collection Instance stub from Material batch." .
cm:DataCollection skos:closeMatch ref:DataCollectionPlan .

cm:DataCollectionParameter a owl:Class ; rdfs:subClassOf cm:DataObject ; rdfs:label "Data Collection Parameter" ;
    cm:verdict "vendor-extension" ;
    cm:sourceDoc "data-collection/manage_data_collection_parameters" ;
    rdfs:comment "A qualified Parameter within a Data Collection: sample material form (batch/lot/wafer), number of samples, readings per sample, mandatory flag, calculation, limit-check mode (Individual/Calculated Value)." .

cm:DataCollectionInstanceObj a owl:Class ; rdfs:subClassOf cm:DataObject ; rdfs:label "Data Collection Instance" ;
    cm:verdict "vendor-extension" ;
    cm:sourceDoc "data-collection/data-collection-instance" ;
    rdfs:comment "Runtime instance of a Data Collection. Immediate / Immediate Ad-hoc / Long Running (open+close). Has its own lifecycle (Open/Post/Close/Correct/Reset) -> run:. Note: distinct IRI from the cm:DataCollectionInstance stub used as a Material association range." .

cm:DataCollectionLimitSet a owl:Class ; rdfs:subClassOf cm:DataObject ; rdfs:label "Data Collection Limit Set" ;
    cm:verdict "vendor-extension" ;
    cm:sourceDoc "data-collection-limit-set/, data-collection-limit-set/create_data_collection_limit_set" ;
    rdfs:comment "Reusable warning/error limit set applied to a Data Collection at a given Step/Resource context, promoting DC reuse where only limits differ. Contains Data Collection Parameter Limits (target, warning + error spec limits). Can open a Protocol on limit exceed. Change-set versioned. No ref: concept for parameterized limit sets. vendor-extension. Resolves DC Limit Set stub." .

cm:DataCollectionParameterLimit a owl:Class ; rdfs:subClassOf cm:DataObject ; rdfs:label "Data Collection Parameter Limit" ;
    cm:verdict "vendor-extension" ;
    cm:sourceDoc "data-collection-limit-set/manage_data_collection_limit_set_parameters" ;
    rdfs:comment "A per-parameter limit within a Limit Set: optional target, warning spec limits, error spec limits." .

cm:DataSilo a owl:Class ; rdfs:subClassOf cm:DataObject ; rdfs:label "Data Silo" ;
    cm:verdict "vendor-extension" ;
    cm:sourceDoc "data-silo/, data-silo/create_data_silo" ;
    rdfs:comment "Logical source of data within the Enterprise Data Platform (EDP, licensed module). Anchor point connecting security context (User), organizational context (Enterprise/Site/Facility), and EDP data model. Each associated with a single User. No ref: concept (EDP-specific data platform). vendor-extension." .

cm:User a owl:Class ; rdfs:subClassOf cm:ExternalReference ; rdfs:label "User" ;
    cm:verdict "vendor-extension" ;
    cm:sourceDoc "(referenced)" ;
    rdfs:comment "Stub referenced by Data Silo. CM security identity object." .

cm:Document a owl:Class ; rdfs:subClassOf cm:DataObject ; rdfs:label "Document" ;
    cm:verdict "vendor-extension" ;
    cm:sourceDoc "document/, document/create_document" ;
    rdfs:comment "External link or binary content (PDF/Word) + metadata, stored centrally (Document Management licensed module). Change-controlled. Each version has version-specific + most-effective URLs. Owner Role restricts changes. Viewable in Material/Resource context. No ref: document concept (consistent with the traveler/document scope boundary). vendor-extension. Resolves Printable Document stub relationship." .

cm:EmployeeQualification a owl:Class ; rdfs:subClassOf cm:DataObject ; rdfs:label "Employee Qualification" ;
    cm:verdict "vendor-extension" ;
    cm:sourceDoc "employee/" ;
    rdfs:comment "Association entity linking Employee to a Qualification (with proficiency/state)." .

cm:EmployeeCertification a owl:Class ; rdfs:subClassOf cm:DataObject ; rdfs:label "Employee Certification" ;
    cm:verdict "vendor-extension" ;
    cm:sourceDoc "employee/" ;
    rdfs:comment "Association entity linking Employee to a Certification (with grant state — see Certification state model)." .

cm:Workgroup a owl:Class ; rdfs:subClassOf cm:DataObject ; rdfs:label "Workgroup" ;
    cm:verdict "vendor-extension" ;
    cm:sourceDoc "CROSS-REFERENCED: employee/ (Assign Team and Workgroup), shift-plan/ (Workgroups with name/description/owner Role; Employee scheduled to Workgroup+Position per Calendar Day). Dedicated business-data/workgroup/ page NOT in scrape and not retrievable via search." ;
    rdfs:comment "A labor-planning grouping of Employees (and Resources per Shift Plan docs) with an owner Role. Employees are assigned to a Team and Workgroup (Employee op: Assign Team and Workgroup); Shift Plans schedule Employees to a Workgroup + Position per Calendar Day. Workgroup membership also filters Notification visibility (Notification batch). NEEDS VERIFICATION: structure below inferred from three corroborating modeled objects, not the dedicated page. No ref: concept. vendor-extension." .

cm:MaintenanceActivityOrder a owl:Class ; rdfs:subClassOf cm:DataObject ; rdfs:label "Maintenance Activity Order" ;
    cm:verdict "covered" ;
    cm:sourceDoc "maintenance-activity-order/, maintenance-activity-order/maintenance_activity_order_page" ;
    rdfs:comment "MAO = a maintenance work order. Four trigger types: Time / Usage / Time and Usage / Ad hoc (time+usage auto-created by system, ad hoc via manual Request). Two independent state models: Schedule State (Before early due/Early due/Due/Late due) and Execution State (Requested/Approved/Released/In Progress/Waiting For Acceptance/Closed/Rejected/Reworked/Skipped/Closed As Joined/Canceled) -> run:. ref:MaintenanceWorkOrder (ISA-95 Part 4 Maintenance Order) closeMatch/0.85. Embeds Qualification workflow ops (compose material, experiment, check verification). Resolves MAO stub from Employee batch." .
cm:MaintenanceActivityOrder skos:closeMatch ref:MaintenanceWorkOrder .

cm:Enterprise a owl:Class ; rdfs:subClassOf cm:DataObject ; rdfs:label "Enterprise" ;
    cm:verdict "vendor-extension" ;
    cm:sourceDoc "enterprise/, enterprise/create_enterprise" ;
    rdfs:comment "ISA-95 top-level object aggregating Sites under one umbrella. Simple object (name/description + Site list). NOTE: ref: has NO Enterprise/Site/Facility/Area classes despite being ISA-95-grounded - the entire ISA-95 physical/equipment hierarchy (Enterprise>Site>Facility>Area) is absent from ref:. This is a systematic ref: gap, logged as a candidate. vendor-extension." .

cm:Site a owl:Class ; rdfs:subClassOf cm:DataObject ; rdfs:label "Site" ;
    cm:verdict "vendor-extension" ;
    cm:sourceDoc "site/, site/create_site" ;
    rdfs:comment "ISA-95 hierarchy level between Enterprise and Facility. Also configures a REMOTE CM instance for Remote Material Shipping (RemoteExportAddress -> Shipping Gateway; plugin-extensible attributes; PAT auth recommended). Part of the ISA-95 hierarchy gap already logged (ref: has no Enterprise/Site/Facility/Area). vendor-extension. Resolves Site stub from Enterprise batch." .

cm:ExperimentDefinition a owl:Class ; rdfs:subClassOf cm:DataObject ; rdfs:label "Experiment Definition" ;
    cm:verdict "vendor-extension" ;
    cm:sourceDoc "experiment-definition/, experiment-definition/create_experiment_definition" ;
    rdfs:comment "Set of all variations to be performed as part of an Experiment - controlled deviation from standard process to test effects (DOE - new materials/processes/recipes). Experiment Management licensed module. Change-set versioned. No ref: concept for experiments/DOE. vendor-extension." .

cm:Experiment a owl:Class ; rdfs:subClassOf cm:DataObject ; rdfs:label "Experiment" ;
    cm:verdict "vendor-extension" ;
    cm:sourceDoc "experiment-definition/experiment" ;
    rdfs:comment "A running Experiment on a Material for a given Experiment Definition. Lifecycle Created/Completed/Closed (run:). Created by assigning a Material to an Experiment Definition." .

cm:FlowItem a owl:Class ; rdfs:subClassOf cm:DataObject ; rdfs:label "Flow Item" ;
    cm:verdict "covered" ;
    cm:sourceDoc "flow/, flow/flow_page" ;
    rdfs:comment "Position holder in a Flow; wraps a Step OR a child Flow. CorrelationId + Position give the unique placement. ref:RouteOperation closeMatch (ref: authored anticipating this: realizes comment = CM Flow Item). Child-Flow nesting has no ref: counterpart (vendor-extension facet)." .
cm:FlowItem skos:closeMatch ref:RouteOperation .

cm:ReworkPath a owl:Class ; rdfs:subClassOf cm:DataObject ; rdfs:label "Rework Path" ;
    cm:verdict "covered" ;
    cm:sourceDoc "flow/view_rework_paths" ;
    rdfs:comment "Go-To + Return path for a Step within a Flow context. ref:ReworkPath closeMatch." .
cm:ReworkPath skos:closeMatch ref:ReworkPath .

cm:FlowLogicalName a owl:Class ; rdfs:subClassOf cm:ExternalReference ; rdfs:label "Flow Logical Name" ;
    cm:verdict "vendor-extension" ;
    cm:sourceDoc "flow/manage_flow_logical_names" ;
    rdfs:comment "Alternative naming scheme for a Flow. No Logical Name/Alias concept in ref: (verified). Re-introduced from the removed routing cluster." .

cm:InspectionPlan a owl:Class ; rdfs:subClassOf cm:DataObject ; rdfs:label "Inspection Plan" ;
    cm:verdict "partial" ;
    cm:sourceDoc "inspection-plan/, inspection-plan/create_inspection_plan" ;
    rdfs:comment "AQL sampling-based inspection plan complying with ISO 2859-1:1999, ANSI/ASQ Z1.4 2018, MIL-STD 105E. Reusable, change-set versioned design-time object; executed at runtime via Inspection Order. ref:SamplingPlan (skip-lot/skip-wafer sampling) is the conceptually adjacent target — relatedMatch/0.55 because ref:SamplingPlan models measurement sampling frequency while CM Inspection Plan models AQL accept/reject inspection with configurations, steps, and order lifecycle. Different shapes, shared quality-sampling domain." .
cm:InspectionPlan skos:relatedMatch ref:SamplingPlan .

cm:InspectionPlanConfiguration a owl:Class ; rdfs:subClassOf cm:DataObject ; rdfs:label "Inspection Plan Configuration" ;
    cm:verdict "vendor-extension" ;
    cm:sourceDoc "inspection-plan/manage_inspection_plan_configurations" ;
    rdfs:comment "Versioned sub-entity: configuration linking Steps, Data Collections, and DC Limit Sets for the plan." .

cm:InspectionPlanStep a owl:Class ; rdfs:subClassOf cm:DataObject ; rdfs:label "Inspection Plan Step" ;
    cm:verdict "vendor-extension" ;
    cm:sourceDoc "inspection-plan/manage_inspection_plan_steps" ;
    rdfs:comment "Versioned sub-entity: a Step within the Inspection Plan (multiple only if Separate Inspection Steps flag set)." .

cm:InspectionOrder a owl:Class ; rdfs:subClassOf cm:DataObject ; rdfs:label "Inspection Order" ;
    cm:verdict "vendor-extension" ;
    cm:sourceDoc "inspection-plan/inspection-order" ;
    rdfs:comment "Non-versioned RUNTIME object implementing an Inspection Plan: links Materials being inspected to Steps, holds context, spawns Inspection Order Step Samples (Step Material Samples) and Inspection Order Materials (qualified relation). Lifecycle Cancel/Close -> run:." .

cm:KPI a owl:Class ; rdfs:subClassOf cm:DataObject ; rdfs:label "KPI" ;
    cm:verdict "vendor-extension" ;
    cm:sourceDoc "kpi/, kpi/create_kpi" ;
    rdfs:comment "Simple object to set/track performance targets on a Parameter, with dimensions and time frames. Types Maximum/Minimum/Deviation. Static (numeric Parameter) or Dynamic source. System KPIs pre-configured. No ref: concept (BI/analytics construct). vendor-extension." .

cm:MaintenanceActivity a owl:Class ; rdfs:subClassOf cm:DataObject ; rdfs:label "Maintenance Activity" ;
    cm:verdict "vendor-extension" ;
    cm:sourceDoc "maintenance-plan/" ;
    rdfs:comment "Versioned sub-entity of a Maintenance Plan: defines trigger nature (Time/Usage/Time+Usage/Ad-hoc), the Checklist to follow, bill of parts (BOM), Data Collection target, labor requirements (Role). Instantiated as MAOs." .

cm:MaintenancePlanInstance a owl:Class ; rdfs:subClassOf cm:DataObject ; rdfs:label "Maintenance Plan Instance" ;
    cm:verdict "vendor-extension" ;
    cm:sourceDoc "maintenance-plan/maintenance-plan-instance" ;
    rdfs:comment "Association entity binding a Maintenance Plan to a target entity (Area/Material/Resource/Container). Has an owner Role. Same entity can associate once per Plan, but multiple MPIs overall." .

cm:MapDefinition a owl:Class ; rdfs:subClassOf cm:DataObject ; rdfs:label "Map Definition" ;
    cm:verdict "partial" ;
    cm:sourceDoc "map-definition/, map-definition/create_map_definition" ;
    rdfs:comment "Defines a matrix structure (rows x columns) with a mask, layers, filters, notch orientation, default rotation, ruler mode. Template for Maps. Mapping licensed module (SEMI G85-0703 format). ref:WaferMap (E142 substrate map) relatedMatch/0.5 — CM Map Definition is the generic matrix TEMPLATE (any gridded data, not only wafers); ref:WaferMap is the die/bin map instance. Related but different level (template vs instance) and scope (generic grid vs wafer)." .
cm:MapDefinition skos:relatedMatch ref:WaferMap .

cm:MapDefinitionLayer a owl:Class ; rdfs:subClassOf cm:DataObject ; rdfs:label "Map Definition Layer" ;
    cm:verdict "vendor-extension" ;
    cm:sourceDoc "map-definition/manage_map_definition_layers" ;
    rdfs:comment "A data layer within a Map Definition, with its own filters. Sub-entity." .

cm:Map a owl:Class ; rdfs:subClassOf cm:DataObject ; rdfs:label "Map" ;
    cm:verdict "covered" ;
    cm:sourceDoc "map/, map/create_map" ;
    rdfs:comment "An instance of a Map Definition holding actual per-layer cell data. Links to a Material (quantity sync possible), Step, Resource. SEMI G85-0703 format. ref:WaferMap (E142 location-indexed die/bin map) closeMatch/0.7 — CM Map is the generic grid instance, most commonly a wafer map. Slightly broader than ref:WaferMap (any matrix data), hence 0.7 not 0.85." .
cm:Map skos:closeMatch ref:WaferMap .

cm:MapLayer a owl:Class ; rdfs:subClassOf cm:DataObject ; rdfs:label "Map Layer" ;
    cm:verdict "vendor-extension" ;
    cm:sourceDoc "map/" ;
    rdfs:comment "Actual data layer of a Map (Map Layer Content per cell). Sub-entity." .

cm:MaterialTransfer a owl:Class ; rdfs:subClassOf cm:DataObject ; rdfs:label "Material Transfer" ;
    cm:verdict "covered" ;
    cm:sourceDoc "material-transfer/, material-transfer/material_transfer_page" ;
    rdfs:comment "CM MaterialTransfer covers material movement between locations. ref:MaterialMovement = 'A transfer of material between locations' (E82/E84 AMHS). CM fully covers this and extends it with approval workflows, cost center integration, MAO integration, warehouse management. broadMatch/0.65 because CM MaterialTransfer is strictly broader (covers non-AMHS warehouse transfers too). Verdict changed from vendor-extension to covered." .
cm:MaterialTransfer skos:broadMatch ref:MaterialMovement .

cm:Package a owl:Class ; rdfs:subClassOf cm:DataObject ; rdfs:label "Package" ;
    cm:verdict "covered" ;
    cm:sourceDoc "package/, package/package_page" ;
    rdfs:comment "Created from Products of Product Type Packaging; a package hierarchy holds Materials at multiple packing levels (Primary/Secondary/Display/Transportation). ref:Package (packaging material) closeMatch/0.7 — CM Package is the packing hierarchy/container-of-materials for shipping, ref:Package is the packaging material type. Related but CM emphasizes multi-level packing structure. Created via Material Pack operations (see Material batch)." .
cm:Package skos:closeMatch ref:Package .

cm:PeriodicInventory a owl:Class ; rdfs:subClassOf cm:DataObject ; rdfs:label "Periodic Inventory" ;
    cm:verdict "partial" ;
    cm:sourceDoc "periodic-inventory/, periodic-inventory/create_periodic_inventory" ;
    rdfs:comment "CM PeriodicInventory reconciles actual vs system quantities. ref:InventoryRecord = 'Stock level / quantity of material at a location.' relatedMatch/0.5: CM object is the reconciliation PROCESS that validates inventory records; ref: is the stock RECORD itself. Same domain, different abstraction level. Verdict changed from vendor-extension to partial." .
cm:PeriodicInventory skos:relatedMatch ref:InventoryRecord .

cm:PickList a owl:Class ; rdfs:subClassOf cm:DataObject ; rdfs:label "Pick List" ;
    cm:verdict "vendor-extension" ;
    cm:sourceDoc "pick-list/, pick-list/pick_list_page" ;
    rdfs:comment "Created from one or more Transfer Requirements; defines specific Materials to pick to fulfill them. Material IDs generated via Storage Area picking strategy/sequence, editable. One Pick List can serve multiple Transfer Requirements with same Source/Target. Lifecycle Open/In Progress/Picked/In Transport/Delivered/Closed -> run:. No ref: concept. vendor-extension." .

cm:Plan a owl:Class ; rdfs:subClassOf cm:DataObject ; rdfs:label "Plan" ;
    cm:verdict "vendor-extension" ;
    cm:sourceDoc "plan/, plan/create_plan" ;
    rdfs:comment "Central production-demand-fulfillment entity: matrix of quantities indexed by manufacturing unit (Product/Product Group = Plan Item) x Time Frames, at a manufacturing level (Area/Facility/Site/Enterprise). Can reference a parent Plan and a plan group. Sub-entities: Plan Item, Plan Step, Plan Time Frame, Plan Time Frame Item. Planning/scheduling construct. No ref: production-plan object (ref: has WorkSchedule for operations schedule, different level). vendor-extension." .

cm:PlanItem a owl:Class ; rdfs:subClassOf cm:DataObject ; rdfs:label "Plan Item" ;
    cm:verdict "vendor-extension" ;
    cm:sourceDoc "plan/manage_plan_items" ;
    rdfs:comment "Specifies items included in a Plan and the Steps where counted as actual volumes." .

cm:PlanScenario a owl:Class ; rdfs:subClassOf cm:DataObject ; rdfs:label "Plan Scenario" ;
    cm:verdict "vendor-extension" ;
    cm:sourceDoc "plan/plan-scenario" ;
    rdfs:comment "A what-if scenario of a Plan; can be released and synchronized with the parent Plan." .

cm:ProductGroup a owl:Class ; rdfs:subClassOf cm:DataObject ; rdfs:label "Product Group" ;
    cm:verdict "partial" ;
    cm:sourceDoc "product-group/, product-group/create_product_group" ;
    rdfs:comment "Product family sharing characteristics. Two purposes: shared Product Parameters, and reducing context-resolution entries (use Group instead of Product). Fully change-set versioned (no global data). ref: has no Product-family/grouping concept; ref:Product is the closest (relatedMatch/0.5 — a grouping abstraction over Products, not a Product itself). Resolves Product Group stub from Plan/Product batches." .
cm:ProductGroup skos:relatedMatch ref:Product .

cm:QualificationCheck a owl:Class ; rdfs:subClassOf cm:DataObject ; rdfs:label "Qualification Check" ;
    cm:verdict "vendor-extension" ;
    cm:sourceDoc "qualification-check/, qualification-check/create_qualification_check" ;
    rdfs:comment "Validates that EQUIPMENT/related items comply with production requirements before processing Productive Material — a Qualification Material is processed through a Flow including the item to be qualified. Qualification Item = Resource / Sub-Resource / Service / Recipe. One check qualifies many items; each item qualified by one check. Requalification: periodic / after maintenance / manual or automatic. Critical in semiconductor FE. No ref: equipment-qualification concept (ref:PersonnelClass is personnel-only). vendor-extension — semiconductor differentiator. NOTE: distinct from Qualification (personnel skill). Resolves QualificationCheck stub if any." .

cm:SamplingPattern a owl:Class ; rdfs:subClassOf cm:DataObject ; rdfs:label "Sampling Pattern" ;
    cm:verdict "partial" ;
    cm:sourceDoc "sampling-pattern/, sampling-pattern/create_sampling_pattern" ;
    rdfs:comment "In-Step sampling: defines which Sub-Materials are sampled at a Step and in which sequence (Sampling Selection). Modes Manual/Rule/System. Container:Position selection format. Combinable with Lot-based Sampling Plan. Sampling licensed module. ref:SamplingPlan (skip-lot/skip-wafer) relatedMatch/0.5 — CM Sampling Pattern is the sub-material/wafer in-step selection, ref:SamplingPlan is the frequency plan. Two CM objects (Pattern + Plan) split what ref: models as one." .
cm:SamplingPattern skos:relatedMatch ref:SamplingPlan .

cm:ScheduleScenarioJob a owl:Class ; rdfs:subClassOf cm:DataObject ; rdfs:label "Schedule Scenario Job" ;
    cm:verdict "vendor-extension" ;
    cm:sourceDoc "schedule-scenario/" ;
    rdfs:comment "A scheduled job within a scenario, linking Step/Flow/Product/Material/Resource with predecessors. Promoted from the stub referenced in the Material batch." .

cm:Protocol a owl:Class ; rdfs:subClassOf cm:DataObject ; rdfs:label "Protocol" ;
    cm:verdict "covered" ;
    cm:sourceDoc "protocol/, protocol/create_protocol" ;
    rdfs:comment "CM Protocol IS the NCR/OCAP. ref:NCR = 'Formal quality deviation record with MRB disposition. CM + Opcenter converge here.' The ref: definition itself states both vendors converge on this concept. CM Protocol = exception management workflow (NCR/OCAPS) with configurable states, roles, checklists, material dispositions, inhibit-ship/inhibit-move. closeMatch/0.8. Verdict changed from vendor-extension to covered." .
cm:Protocol skos:closeMatch ref:NonConformanceReport .

cm:ProtocolInstance a owl:Class ; rdfs:subClassOf cm:DataObject ; rdfs:label "Protocol Instance" ;
    cm:verdict "vendor-extension" ;
    cm:sourceDoc "protocol/protocol-instance" ;
    rdfs:comment "Runtime occurrence of a Protocol workflow. Associated with 1+ Materials. Instance-wide props: Inhibit Ship (block ship while open), Inhibit Move From Step (block step change while open). Full state workflow (Open/Perform/Change State/Close/Terminate) with per-state Role/Checklist/dispositions/tasks -> run:." .

cm:ScheduleScenario a owl:Class ; rdfs:subClassOf cm:DataObject ; rdfs:label "Schedule Scenario" ;
    cm:verdict "vendor-extension" ;
    cm:sourceDoc "schedule-scenario/, schedule-scenario/generate_schedule_scenario" ;
    rdfs:comment "A working (unreleased) scheduling scenario: generate + compare multiple, release one to become effective. Contains Scenario Jobs (with predecessors + lock), Untie Sort Rules, Scenario Materials, Optimization Criteria, KPIs, Messages. No ref: concept (optimizer artifact). vendor-extension." .

cm:SendAheadRun a owl:Class ; rdfs:subClassOf cm:DataObject ; rdfs:label "Send-Ahead Run" ;
    cm:verdict "vendor-extension" ;
    cm:sourceDoc "send-ahead-run/, send-ahead-run/create_send_ahead_run" ;
    rdfs:comment "Semiconductor pilot-wafer pattern: a Sub-Material (Send-Ahead Material) processes through defined Steps while the rest of the lot waits at a Wait Step; results evaluated at an evaluation Step; on accept, Waiting Materials release and optionally merge back. On reject, rework + new send-ahead. Split types None/Logical/Physical, scope Temporary/Permanent. No ref: send-ahead/pilot concept. vendor-extension — strong FE differentiator." .

cm:SetupMatrixTransition a owl:Class ; rdfs:subClassOf cm:DataObject ; rdfs:label "Setup Matrix Transition" ;
    cm:verdict "vendor-extension" ;
    cm:sourceDoc "setup-matrix/ (Tying Everything Together)" ;
    rdfs:comment "A single From-Service -> To-Service changeover time entry within a Setup Matrix." .

cm:ShiftDefinitionShift a owl:Class ; rdfs:subClassOf cm:DataObject ; rdfs:label "Shift Definition Shift" ;
    cm:verdict "vendor-extension" ;
    cm:sourceDoc "shift-definition/manage_shift_definition_shifts" ;
    rdfs:comment "A single Shift within a Shift Definition: name, start/end time, plus non-working times." .

cm:ShiftLogbook a owl:Class ; rdfs:subClassOf cm:DataObject ; rdfs:label "Shift Logbook" ;
    cm:verdict "vendor-extension" ;
    cm:sourceDoc "shift-logbook/, shift-logbook/add_shift_logbook_entry" ;
    rdfs:comment "Shift pass-down mechanism (Labor Management licensed module). Organized by Area; auto-created per Shift when configured. Multiple entries; next-shift supervisor signs off, terminating it. No ref: concept. vendor-extension." .

cm:SortRuleSetRule a owl:Class ; rdfs:subClassOf cm:DataObject ; rdfs:label "Sort Rule Set Rule" ;
    cm:verdict "vendor-extension" ;
    cm:sourceDoc "sort-rule-set/manage_rules" ;
    rdfs:comment "Ordered entry: a Rule + sorting direction (Ascending/Descending), applied in sequence." .

cm:StepLogicalName a owl:Class ; rdfs:subClassOf cm:ExternalReference ; rdfs:label "Step Logical Name" ;
    cm:verdict "vendor-extension" ;
    cm:sourceDoc "(referenced)" ;
    rdfs:comment "Stub — intended-usage name for a Step within a Flow version. No ref: LogicalName concept." .

cm:SubstrateMapOverlay a owl:Class ; rdfs:subClassOf cm:DataObject ; rdfs:label "Substrate Map Overlay" ;
    cm:verdict "vendor-extension" ;
    cm:sourceDoc "substrate-map/create_substrate_map_overlay" ;
    rdfs:comment "An overlay (data layer/version) over a base Substrate Map — e.g. a BinCodeMap overlay. Can synchronize quantity with the linked Material; carries Overlay Information." .

cm:SubstrateMapMask a owl:Class ; rdfs:subClassOf cm:DataObject ; rdfs:label "Substrate Map Mask" ;
    cm:verdict "vendor-extension" ;
    cm:sourceDoc "substrate-map-mask/, substrate-map-mask/create_substrate_map_mask" ;
    rdfs:comment "A mask over a substrate (E142 format) controlling which units undergo a process (etch/deposition/chemical). Content restrictions: single map + single BinCodeMap overlay + single version; exactly two non-null bin definitions (SetValue count>0, EmptyBinValue count>=0). Created from file or by region selection on a Substrate Map. Applied to Substrate Maps. Optional Loss/Bonus Reason. No ref: mask concept. vendor-extension." .

cm:Task a owl:Class ; rdfs:subClassOf cm:DataObject ; rdfs:label "Task" ;
    cm:verdict "vendor-extension" ;
    cm:sourceDoc "task/, task/create_task" ;
    rdfs:comment "Generic action item assigned to an Employee, tracked in the system (notifications module). Lifecycle Created->Released->In Progress->Completed (+Canceled) -> run:. Priority Low/Medium/High, due date, reminders. Linked to Protocol Instance Tasks. No ref: concept. vendor-extension." .

cm:TransferOrder a owl:Class ; rdfs:subClassOf cm:DataObject ; rdfs:label "Transfer Order" ;
    cm:verdict "vendor-extension" ;
    cm:sourceDoc "transfer-order/, transfer-order/create_transfer_order" ;
    rdfs:comment "Executes movement: created from Transfer Requirements or Pick Lists, or Ad-hoc. Can move quantities WITHOUT individual Materials (Packaging Units — ERP-quantity case; units created after delivery, before close). Same Source/Destination across joined TRs; remote-Facility restriction. Lifecycle Open->In Progress->Delivered->Closed (+Canceled) -> run:. vendor-extension." .

cm:WorkflowState a owl:Class ; rdfs:subClassOf cm:DataObject ; rdfs:label "Workflow State" ;
    cm:verdict "vendor-extension" ;
    cm:sourceDoc "CROSS-REFERENCED: change-set/ (Manage Change Set State Reviewers)" ;
    rdfs:comment "A state within an approval Workflow, carrying reviewer Roles and reviewer types (Approver / Notified). NEEDS VERIFICATION — inferred from Change Set State Reviewers operation." .

cm:Service a owl:Class ; rdfs:subClassOf cm:DataObject ; rdfs:label "Service" ;
    cm:verdict "vendor-extension" ;
    cm:sourceDoc "service/, service/create_service" ;
    rdfs:comment "THE dispatch-matching abstraction: Material at a Step requires a Service; Resources provide Services; dispatch on match. No ref: service-matching concept (ref: connects Step to Equipment directly). vendor-extension — core CM architectural indirection (Step<->Service<->Resource). [Class row restored — was referenced by 40+ properties/operations but the promote() no-op left it undeclared.]" .

cm:Reason a owl:Class ; rdfs:subClassOf cm:DataObject ; rdfs:label "Reason" ;
    cm:verdict "covered" ;
    cm:sourceDoc "reason/, reason/create_reason" ;
    rdfs:comment "Code/category for losses, bonuses, off-flow, hold, defect, pause, rework. ref:ReasonCode (SKOS ConceptScheme) closeMatch/0.85. [Class row restored — was referenced by Material Hold, Step, Send-Ahead, Substrate Map Mask etc. but left undeclared by promote() no-op.]" .
cm:Reason skos:closeMatch ref:ReasonCode .

cm:SamplingPlan a owl:Class ; rdfs:subClassOf cm:DataObject ; rdfs:label "Sampling Plan" ;
    cm:verdict "covered" ;
    cm:sourceDoc "sampling-plan/, sampling-plan/create_sampling_plan" ;
    rdfs:comment "Counter-based and time-based lot sampling; attached to Steps as Sampling Evaluation Steps. ref:SamplingPlan closeMatch/0.8. [Class row restored — was referenced by Step + Sampling Pattern but left undeclared by promote() no-op.]" .
cm:SamplingPlan skos:closeMatch ref:SamplingPlan .

cm:PrintableDocument a owl:Class ; rdfs:subClassOf cm:DataObject ; rdfs:label "Printable Document" ;
