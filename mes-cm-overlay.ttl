cm:SmartTableContext a owl:Class ; rdfs:subClassOf cm:DataObject ; rdfs:label "Smart Table Context" ;
    cm:verdict "vendor-extension" ;
    cm:sourceDoc "tables/smart-tables/ (48 tables)" ;
    rdfs:comment "ABSTRACT superclass for CM Smart Table Contexts — the pervasive runtime-resolution mechanism. A Smart Table holds rows keyed by a combination of KEY fields; at runtime CM matches the current transaction against the rows using an ORDERED PRECEDENCE list (most-specific first) and returns the first match. This is how Step and Resource connect to most other objects: not by static association but by context resolution. 42 context tables + 6 other smart tables exist. Requires ContextResolution.EditData security feature. NO ref: EQUIVALENT — ref: models these as direct associations (e.g. ref:DataCollectionPlan collectsAtStep ref:Step). MAJOR CM ARCHITECTURAL DIFFERENTIATOR vs Opcenter." .

cm:ApplicationSettingsContext a owl:Class ; rdfs:subClassOf cm:DataObject ; rdfs:label "Application Settings Context" ;
