# ============================================================
# OBJECT PROPERTIES
# ============================================================

cm:belongsToFacility a owl:ObjectProperty ; rdfs:label "belongsToFacility" ; rdfs:domain cm:Area ;
    rdfs:range cm:Facility ;
    rdfs:comment "cardinality 1; Mandatory on Create Area. No ref:Facility target exists." ;
    cm:verdict "vendor-extension" .

cm:hasCalendar a owl:ObjectProperty ; rdfs:label "hasCalendar" ; rdfs:domain cm:Area ;
    rdfs:range cm:Calendar ;
    rdfs:comment "cardinality 1 (stated) / \"always\" (Overview); conditional on Doc structure places the mandatory step only under the plain 'Area' classification branch, but the Overview states Calendar association 'always' applies — preserved as an unresolved discrepancy rather than silently picking one.; No ref:Calendar target exists." ;
    cm:verdict "vendor-extension" .

cm:hasSchedule a owl:ObjectProperty ; rdfs:label "hasSchedule" ; rdfs:domain cm:Area ;
    rdfs:range cm:Schedule ;
    rdfs:comment "cardinality 0..1; conditional on areaClassification = Area (per doc structure); See Data Objects sheet — needs verification against CM's own Schedule page before confidence is raised." ;
    cm:verdict "partial" .
cm:hasSchedule skos:relatedMatch ref:WorkSchedule .

cm:parentArea a owl:ObjectProperty ; rdfs:label "parentArea" ; rdfs:domain cm:Area ;
    rdfs:range cm:Area ;
    rdfs:comment "cardinality 0..1; conditional on Required if areaClassification != Area; Self-referencing hierarchy. Area Page's 'Sub-Areas' panel is the inverse traversal of this same edge, not a separate property." ;
    cm:verdict "vendor-extension" .

cm:hasSupplyArea a owl:ObjectProperty ; rdfs:label "hasSupplyArea" ; rdfs:domain cm:Area ;
    rdfs:range cm:Area ;
    rdfs:comment "cardinality 0..*; Relationship existence confirmed — CM docs confirm Manage Supply Areas is a real Specific Operation on Area, meaning the supply relationship is a persisted object property, not just a transient UI operation. Cardinality updated from NEEDS VERIFICATION to 0..* (an Area can have zero or more supply areas). Detailed semantics (direction, restrictions) still need verification against the dedicated Supply Areas page, not yet fetched. Resolves reviewer gap #2 (partially)." ;
    cm:verdict "vendor-extension" .

cm:assignedEmployee a owl:ObjectProperty ; rdfs:label "assignedEmployee" ; rdfs:domain cm:Area ;
    rdfs:range cm:Employee ;
    rdfs:comment "cardinality NEEDS VERIFICATION; Diagram shows an undirected association line only; direction and cardinality not stated in prose anywhere on the fetched pages." ;
    cm:verdict "vendor-extension" .

cm:hasNotification a owl:ObjectProperty ; rdfs:label "hasNotification" ; rdfs:domain cm:Area ;
    rdfs:range cm:Notification ;
    rdfs:comment "cardinality NEEDS VERIFICATION; Same caveat as assignedEmployee." ;
    cm:verdict "vendor-extension" .

cm:pickingStrategy a owl:ObjectProperty ; rdfs:label "pickingStrategy" ; rdfs:domain cm:Area ;
    rdfs:range cm:SortRuleSet ;
    rdfs:comment "cardinality 0..1; conditional on areaClassification = Storage Area; Range reuses the cm:SortRuleSet stub already declared in the Flow+Step batch (Step sheet) — no new Data Object row added for it here." ;
    cm:verdict "vendor-extension" .

cm:pickingSequence a owl:ObjectProperty ; rdfs:label "pickingSequence" ; rdfs:domain cm:Area ;
    rdfs:range cm:SortRuleSet ;
    rdfs:comment "cardinality 0..1; conditional on areaClassification = Storage Area; Same Sort Rule Set stub as pickingStrategy." ;
    cm:verdict "vendor-extension" .

cm:flowPath a owl:ObjectProperty ; rdfs:label "flowPath" ; rdfs:domain cm:Area ;
    rdfs:comment "cardinality 1; conditional on areaClassification = Production Line OR Storage Area; 'Select a Flow Path for the Area to be primarily used when receiving a Material...' — range not confirmed; plausibly relates to ref:Step/ref:RouteOperation but not asserted without the dedicated CM Flow Path source." ;
    cm:verdict "vendor-extension" .

cm:incomingPickingPlace a owl:ObjectProperty ; rdfs:label "incomingPickingPlace" ; rdfs:domain cm:Area ;
    rdfs:comment "cardinality 0..1; conditional on areaClassification = Production Line OR Storage Area; ref:StorageLocation exists (Structure) and is a plausible target given the 'Picking Place' terminology, but the CM Picking Place object itself has not been sourced — confidence deliberately low." ;
    cm:verdict "partial" .
cm:incomingPickingPlace skos:relatedMatch ref:StorageLocation .

cm:outgoingPickingPlace a owl:ObjectProperty ; rdfs:label "outgoingPickingPlace" ; rdfs:domain cm:Area ;
    rdfs:comment "cardinality 0..1; conditional on areaClassification = Production Line OR Storage Area; Same caveat as incomingPickingPlace." ;
    cm:verdict "partial" .
cm:outgoingPickingPlace skos:relatedMatch ref:StorageLocation .

cm:batchResource a owl:ObjectProperty ; rdfs:label "batchResource" ; rdfs:domain cm:Batch ;
    rdfs:range cm:Resource ;
    rdfs:comment "cardinality 1; conditional on Only Resources with Batch Scheduling Type; Range reuses the cm:Resource stub already declared in the Area batch — no new Data Object row added for it here." ;
    cm:verdict "vendor-extension" .

cm:batchStep a owl:ObjectProperty ; rdfs:label "batchStep" ; rdfs:domain cm:Batch ;
    rdfs:range cm:Step ;
    rdfs:comment "cardinality 1; Range reuses cm:Step (already covered -> ref:Step). The Batch-Step link itself is not mapped (no ref: concept for a batch-of-materials sharing one Step)." ;
    cm:verdict "vendor-extension" .

cm:hasBatchMaterial a owl:ObjectProperty ; rdfs:label "hasBatchMaterial" ; rdfs:domain cm:Batch ;
    rdfs:range cm:BatchMaterial ;
    rdfs:comment "cardinality 1..*; conditional on at least one Batch Material must be flagged Main Material" ;
    cm:verdict "vendor-extension" .

cm:batchMaterialIsMaterial a owl:ObjectProperty ; rdfs:label "batchMaterialIsMaterial" ; rdfs:domain cm:BatchMaterial ;
    rdfs:range cm:Material ;
    rdfs:comment "cardinality 1; Range reuses cm:Material stub (already covered -> ref:Material). Material must have a defined Capacity Class to be eligible — Capacity Class itself not modeled here (lives on Material/Product configuration, see Candidates)." ;
    cm:verdict "vendor-extension" .

cm:batchMaterialStep a owl:ObjectProperty ; rdfs:label "batchMaterialStep" ; rdfs:domain cm:BatchMaterial ;
    rdfs:range cm:Step ;
    rdfs:comment "cardinality 0..1; conditional on non-Main Material may use a different Step than the Batch Step, if the Step's Required Service is available/compatible on the Batch Resource" ;
    cm:verdict "vendor-extension" .

cm:hasBatchContainer a owl:ObjectProperty ; rdfs:label "hasBatchContainer" ; rdfs:domain cm:Batch ;
    rdfs:range cm:Container ;
    rdfs:comment "cardinality 0..*; conditional on only if a Batch Container Type is defined on the Batch Resource; Plain membership relation, no per-container attributes documented — deliberately NOT modeled as a separate association entity (contrast with Batch Material)." ;
    cm:verdict "vendor-extension" .

cm:createsResourceJob a owl:ObjectProperty ; rdfs:label "createsResourceJob" ; rdfs:domain cm:Batch ;
    rdfs:range cm:ResourceJob ;
    rdfs:comment "cardinality 1; conditional on auto-created on Batch creation, not user-set; See Data Objects sheet for the ResourceJob -> ref:ProcessJob needs-verification hypothesis." ;
    cm:verdict "vendor-extension" .

cm:hasBinConversion a owl:ObjectProperty ; rdfs:label "hasBinConversion" ; rdfs:domain cm:BinConverter ;
