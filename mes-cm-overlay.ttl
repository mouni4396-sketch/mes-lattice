cm:stepHasSmartTableContext a owl:ObjectProperty ; rdfs:label "hasSmartTableContext" ; rdfs:domain cm:Step ;
    rdfs:range cm:SmartTableContext ;
    rdfs:comment "cardinality 0..*; THE KEY EDGE: Step connects to most objects via Smart Table Contexts (Chart, Inspection Plan, Line Flow, Sampling Pattern, Rework Limits, Split Track-Out, Certification Requirements, Product Yield/Cycle Time), and via Material-keyed contexts where Step is a mandatory key (Data Collection, Checklist, Document, Durables, Container Type, Packing, Printable Document, In-Process Verification, Service, BOM, Time Constraints, Map Definition, Recipe)." ;
    cm:verdict "vendor-extension" .

cm:resourceHasSmartTableContext a owl:ObjectProperty ; rdfs:label "hasSmartTableContext" ; rdfs:domain cm:Resource ;
    rdfs:range cm:SmartTableContext ;
    rdfs:comment "cardinality 0..*; Resource connects via Chart, Checklist, Data Collection, Document, Replenishment, Substrate Map Bin Converter contexts, and appears as a resolution key in many Step/Material contexts." ;
    cm:verdict "vendor-extension" .

cm:materialHasSmartTableContext a owl:ObjectProperty ; rdfs:label "hasSmartTableContext" ; rdfs:domain cm:Material ;
    rdfs:range cm:SmartTableContext ;
    rdfs:comment "cardinality 0..*; Material-keyed contexts: Data Collection, Checklist, Document, Durables, Container Type, Packing, Printable Document, In-Process Verification." ;
    cm:verdict "vendor-extension" .

cm:resourceIsLoadPort a owl:ObjectProperty ; rdfs:label "isLoadPort" ; rdfs:domain cm:Resource ;
    rdfs:range cm:Resource ;
    rdfs:comment "cardinality 0..1; conditional on processingType = Load Port; A Resource with ProcessingType=Load Port IS a SEMI E87 Load Port (\"input/output port for a resource\"). ref:LoadPort covered via this ProcessingType — same pattern as equipment (Resource ProcessingType=Process -> ref:Equipment). Not a separate class in CM." ;
    cm:verdict "covered" .
cm:resourceIsLoadPort skos:closeMatch ref:LoadPort .

cm:resourceIsStorage a owl:ObjectProperty ; rdfs:label "isStorageLocation" ; rdfs:domain cm:Resource ;
    rdfs:range cm:Resource ;
    rdfs:comment "cardinality 0..1; conditional on processingType = Storage; A Resource with ProcessingType=Storage covers ref:StorageLocation (SEMI E88 stocker/store). Covered via ProcessingType, not a separate class." ;
    cm:verdict "covered" .
cm:resourceIsStorage skos:closeMatch ref:StorageLocation .

cm:materialAsLot a owl:ObjectProperty ; rdfs:label "isFormLot" ; rdfs:domain cm:Material ;
    rdfs:range cm:Material ;
    rdfs:comment "cardinality 0..1; conditional on MaterialForm / MaterialType = (customer-defined); A CM Material tracked as a lot-form quantity IS ref:Lot. CM has no separate Lot class; Material with a lot Form covers it. broadMatch — one CM class spans lot + wafer + die etc. NOTE: MaterialType/MaterialForm ship EMPTY in CM (customer-defined); this mapping reflects CM's single polymorphic Material class spanning the ref: subtype, not a built-in type value." ;
    cm:verdict "covered" .
cm:materialAsLot skos:broadMatch ref:Lot .

cm:materialAsSubstrate a owl:ObjectProperty ; rdfs:label "isFormSubstrate" ; rdfs:domain cm:Material ;
    rdfs:range cm:Material ;
    rdfs:comment "cardinality 0..1; conditional on MaterialForm / MaterialType = (customer-defined); CM Material in wafer/substrate form covers ref:Substrate (E90). Sub-material hierarchy + Substrate Map handle wafer tracking. broadMatch. NOTE: MaterialType/MaterialForm ship EMPTY in CM (customer-defined); this mapping reflects CM's single polymorphic Material class spanning the ref: subtype, not a built-in type value." ;
    cm:verdict "covered" .
cm:materialAsSubstrate skos:broadMatch ref:Substrate .

cm:materialAsDie a owl:ObjectProperty ; rdfs:label "isFormDie" ; rdfs:domain cm:Material ;
    rdfs:range cm:Material ;
    rdfs:comment "cardinality 0..1; conditional on MaterialForm / MaterialType = (customer-defined); CM Material at die level (sub-materials of a wafer) covers ref:Die. Die-level tracking via sub-material composition + Substrate Map device genealogy. broadMatch. NOTE: MaterialType/MaterialForm ship EMPTY in CM (customer-defined); this mapping reflects CM's single polymorphic Material class spanning the ref: subtype, not a built-in type value." ;
    cm:verdict "covered" .
cm:materialAsDie skos:broadMatch ref:Die .

cm:materialAsModule a owl:ObjectProperty ; rdfs:label "isFormModule" ; rdfs:domain cm:Material ;
    rdfs:range cm:Material ;
    rdfs:comment "cardinality 0..1; conditional on MaterialForm / MaterialType = (customer-defined); CM Material in module/SiP form covers ref:Module (advanced packaging, Derived scope). broadMatch. NOTE: MaterialType/MaterialForm ship EMPTY in CM (customer-defined); this mapping reflects CM's single polymorphic Material class spanning the ref: subtype, not a built-in type value." ;
    cm:verdict "covered" .
cm:materialAsModule skos:broadMatch ref:Module .

cm:materialAsInterposer a owl:ObjectProperty ; rdfs:label "isFormInterposer" ; rdfs:domain cm:Material ;
    rdfs:range cm:Material ;
    rdfs:comment "cardinality 0..1; conditional on MaterialForm / MaterialType = (customer-defined); CM Material in interposer form covers ref:Interposer (advanced packaging). broadMatch. NOTE: MaterialType/MaterialForm ship EMPTY in CM (customer-defined); this mapping reflects CM's single polymorphic Material class spanning the ref: subtype, not a built-in type value." ;
    cm:verdict "covered" .
cm:materialAsInterposer skos:broadMatch ref:Interposer .

cm:materialAsPackageSubstrate a owl:ObjectProperty ; rdfs:label "isFormPackageSubstrate" ; rdfs:domain cm:Material ;
    rdfs:range cm:Material ;
    rdfs:comment "cardinality 0..1; conditional on MaterialForm / MaterialType = (customer-defined); CM Material in package-substrate/laminate form covers ref:PackageSubstrate. broadMatch. NOTE: MaterialType/MaterialForm ship EMPTY in CM (customer-defined); this mapping reflects CM's single polymorphic Material class spanning the ref: subtype, not a built-in type value." ;
    cm:verdict "covered" .
cm:materialAsPackageSubstrate skos:broadMatch ref:PackageSubstrate .

cm:materialIsConsumable a owl:ObjectProperty ; rdfs:label "isConsumable" ; rdfs:domain cm:Material ;
    rdfs:range cm:Material ;
    rdfs:comment "cardinality 0..1; CM Material attached as a consumable (Attach as Consumable op, consumable-feed Resources) IS ref:ConsumableMaterial. Covered polymorphically via cm:Material in consumable role — not a separate class. Evidence: material/attach_as_consumable." ;
    cm:verdict "covered" .
cm:materialIsConsumable skos:broadMatch ref:ConsumableMaterial .

cm:materialIsDurable a owl:ObjectProperty ; rdfs:label "isDurable" ; rdfs:domain cm:Material ;
    rdfs:range cm:Material ;
    rdfs:comment "cardinality 0..1; CM Durables (reusable tooling — reticles, probe cards) ARE Materials tracked via the Durables context and Qualification. Covered via cm:Material in durable role. Evidence: step Durables Context, qualification-check." ;
    cm:verdict "covered" .
cm:materialIsDurable skos:broadMatch ref:DurableMaterial .

cm:dataCollectionCollectsMeasurement a owl:ObjectProperty ; rdfs:label "collectsMeasurement" ; rdfs:domain cm:DataCollection ;
    rdfs:range cm:DataCollection ;
    rdfs:comment "cardinality 0..1; CM Data Collection collects readings/parameter values for material at a step (E134). The collected data IS ref:MeasurementResult. closeMatch. Evidence: data-collection (readings per sample, limit checking)." ;
    cm:verdict "covered" .
cm:dataCollectionCollectsMeasurement skos:closeMatch ref:MeasurementResult .

cm:reasonAsDefect a owl:ObjectProperty ; rdfs:label "asDefect" ; rdfs:domain cm:Reason ;
    rdfs:range cm:Reason ;
    rdfs:comment "cardinality 0..1; CM models defects via cm:Reason with type=Defect (+ Record Material Defect operation, repair actions). ref:Defect is a coded located quality finding (E142). relatedMatch — CM Reason is a category/code, ref:Defect adds location/bin. partial." ;
    cm:verdict "partial" .
cm:reasonAsDefect skos:relatedMatch ref:Defect .

cm:chartRuleDetectsSPCViolation a owl:ObjectProperty ; rdfs:label "detectsSPCViolation" ; rdfs:domain cm:ChartRule ;
    rdfs:range cm:ChartRule ;
    rdfs:comment "cardinality 0..1; CM Chart Rules (Nelson/Western Electric) detect SPC violations and can auto-open a Protocol. The detected event IS ref:SPCViolation. closeMatch. Evidence: chart/manage_chart_rules." ;
    cm:verdict "covered" .
cm:chartRuleDetectsSPCViolation skos:closeMatch ref:SPCViolation .

cm:resourceHasResourceStateHistory a owl:ObjectProperty ; rdfs:label "hasResourceStateHistory" ; rdfs:domain cm:Resource ;
    rdfs:range cm:Resource ;
    rdfs:comment "cardinality 0..1; CM Resources follow a State Model with Change Resource State + automatic state-change transitions (E10/E58). ref:EquipmentStateLog is the time-stamped HISTORY. relatedMatch — CM has the state mechanism + E58 lookups; the persisted log is a run:-layer record. partial. Evidence: resource/change_resource_state, automatic_resource_state_change_transitions." ;
    cm:verdict "partial" .
cm:resourceHasResourceStateHistory skos:relatedMatch ref:EquipmentStateLog .

cm:resourceInResourceGroup a owl:ObjectProperty ; rdfs:label "inResourceGroup" ; rdfs:domain cm:Resource ;
    rdfs:range cm:Resource ;
    rdfs:comment "cardinality 0..1; CM Resources carry a Resource Group property (free-text grouping, used in resource clusters). Covers ref:EquipmentGroup. closeMatch. Evidence: resource/using_propagation_validation." ;
    cm:verdict "covered" .
cm:resourceInResourceGroup skos:closeMatch ref:EquipmentGroup .

